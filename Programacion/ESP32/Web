async function waitChatJob(job,timeout=34000,jobBase=apiBase){
 const start=Date.now();
 let networkFailures=0,notFound=0;
 while(Date.now()-start<timeout){
  await sleep(450);
  try{
   const r=await fetchJsonAnyFrom(jobBase,'/api/chat/result?id='+encodeURIComponent(job),{},3200,1);
   if(r.status===200)return r.data;
   if(r.status===202){networkFailures=0;notFound=0;continue}
   if(r.status===404){notFound++;if(notFound<3)continue}
   throw new Error('Resultado IA '+r.status);
  }catch(e){
   networkFailures++;
   if(networkFailures>=4)throw e;
   await sleep(Math.min(350+networkFailures*150,1400));
  }
 }
 throw new Error('Tiempo de espera agotado');
}
async function requestChat(jobBase,text,compactHistory,requestId){
 return fetchJsonAnyFrom(jobBase,'/api/chat',{method:'POST',headers:{'Content-Type':'text/plain;charset=UTF-8'},body:JSON.stringify({message:text,history:compactHistory,name:userName,request_id:requestId})},3500,2);
}
async function ask(text){
 go('chat');text=(text||$('#input').value).trim();if(!text||chatBusy)return;
 $('#input').value='';addMsg('user',text);history.push({role:'user',content:text});saveHistory();
 const load=addMsg('assistant','', '',true);chatBusy=true;
 try{
  const jobBase=apiBase;
  const requestId=Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,10);
  const compactHistory=history.slice(-4).map(m=>({role:m.role,content:String(m.content||'').slice(0,260)}));
  const deadline=Date.now()+38000;
  let d=null,lastError=null;
  for(let recovery=0;recovery<2&&!d;recovery++){
   try{
    const r=await requestChat(jobBase,text,compactHistory,requestId);
    const candidate=r.data;
    if(r.status===202&&candidate.queued&&candidate.job){
     const remaining=Math.max(6000,deadline-Date.now());
     d=await waitChatJob(candidate.job,remaining,jobBase);
    }else if(r.ok)d=candidate;
    else throw new Error(candidate.error||('HTTP '+r.status));
   }catch(e){
    lastError=e;
    if(recovery===0&&Date.now()<deadline-6500)await sleep(850);
   }
  }
  if(!d)throw lastError||new Error('Respuesta no disponible');
  load.remove();const answer=d.answer||d.error||'No pude responder en este momento.';
  const meta=d.mode==='online'?'IA ONLINE':(d.mode==='project'?'ATOM.IA · BASE DEL PROYECTO':(d.notice==='external_recovery'?'MODO LOCAL · ENLACE EXTERNO EN RECUPERACIÓN':'MODO LOCAL · ATOM.IA'));
  addMsg('assistant',answer,meta);history.push({role:'assistant',content:answer});saveHistory();
 }catch(e){
  load.remove();addMsg('assistant','Estoy disponible en modo local. La respuesta externa no pudo recuperarse en este momento; puedes volver a intentarlo o preguntarme sobre ATOM-ArchBot y Los Harneritos.','MODO LOCAL · ENLACE EXTERNO EN RECUPERACIÓN');
 }finally{chatBusy=false}
}
