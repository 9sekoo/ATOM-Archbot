function renderFindings(){
 const list=$('#findingsList');
 if(!list)return;
 $('#findingCount').textContent=findings.length===0?'SIN REGISTROS':`${findings.length} ${findings.length===1?'REGISTRO':'REGISTROS'}`;
 if(!findings.length){
  list.innerHTML='<div class="emptyHistory"><b>Aún no hay hallazgos</b>Este registro evita que una coincidencia detectada durante la sesión se pierda y facilita revisarla después.</div>';
  return;
 }
 list.innerHTML=findings.slice().reverse().map((f,index)=>{
  const number=findings.length-index;
  const time=f.time?new Date(f.time).toLocaleTimeString('es-CL',{hour:'2-digit',minute:'2-digit',second:'2-digit'}):'Hora no disponible';
  const image=objectReferenceImages[Number(f.object_id||0)]||'';
  const thumb=image?`<img class="findingThumb" src="${image}" alt="Referencia visual de ${esc(f.name||'objeto de interés')}">`:'';
  return `<article class="findingCard">${thumb}<div class="findingNumber">${number}</div><div class="findingMain"><b>${esc(f.name||'Objeto de interés')}</b><small>Evento ${esc(f.event||'—')} · ${esc(time)} · coincidencia visual registrada para revisión</small></div><div class="findingConfidence">${Number(f.confidence||0)}%<small>confianza</small></div></article>`;
 }).join('');
}
function registerFinding(a,item){
 const event=Number(a.event||0);
 if(!event||findings.some(f=>Number(f.event)===event))return;
 findings.push({event,name:item.name,object_id:Number(a.object_id||0),confidence:Number(a.confidence||0),time:Date.now()});
 saveFindings();
}
function saveHistory(){
 while(history.filter(m=>m&&m.kind==='detection').length>MAX_SESSION_FINDINGS){
  const oldest=history.findIndex(m=>m&&m.kind==='detection');
  if(oldest<0)break;
