<div class="modal hidden" id="nameModal"><div class="modalBox"><div class="kicker">Bienvenido a la expedición</div><h2>¿Cómo te llamas?</h2><p>Solo lo usaré para hacer esta sesión un poco más cercana.</p><input id="nameInput" maxlength="28" placeholder="Tu nombre"><div class="modalActions"><button class="cta" id="saveName">Comenzar →</button></div></div></div>
<script>
const $=s=>document.querySelector(s), side=$('#side');
const titles={home:'Inicio',chat:'Chat con ATOM.ia',archbot:'ATOM-ArchBot',sources:'Fuentes',team:'Los Harneritos',about:'Sobre ATOM.ia',fun:'Explorar y divertirse'};
let userName=localStorage.getItem('atomia_name')||'', history=[];try{history=JSON.parse(sessionStorage.getItem('atomia_history')||'[]')}catch(e){history=[]}let lastEvent=0;
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function go(p){document.querySelectorAll('.page').forEach(x=>x.classList.add('hidden'));$('#page-'+p).classList.remove('hidden');document.querySelectorAll('.nav button[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===p));$('#pageTitle').textContent=titles[p]||'ATOM.ia';side.classList.remove('open')}
document.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>go(b.dataset.page));
function setName(n){userName=(n||'explorador').trim().slice(0,28)||'explorador';localStorage.setItem('atomia_name',userName);$('#sideName').textContent=userName;$('#chatHello').textContent=`¡Hola, ${userName}! 👋`;$('#mascotGreeting').textContent=`¡Hola, ${userName}! Soy ATOM.ia`;}
function newSession(){history=[];sessionStorage.removeItem('atomia_history');$('#messages').innerHTML='';$('#chatWelcome').style.display='block';localStorage.removeItem('atomia_name');userName='';$('#nameInput').value='';$('#nameModal').classList.remove('hidden');$('#nameInput').focus();go('home')}
$('#resetSession').onclick=newSession;$('#saveName').onclick=()=>{setName($('#nameInput').value);$('#nameModal').classList.add('hidden');go('chat');if(!history.length){const saludo=`¡Hola, ${userName}! Soy ATOM.ia. Qué gusto tenerte por aquí. Puedes preguntarme sobre ATOM-ArchBot, arqueología, ciencia, tecnología o cualquier tema que quieras.`;addMsg('assistant',saludo,'ATOM.IA');history.push({role:'assistant',content:saludo});sessionStorage.setItem('atomia_history',JSON.stringify(history))}};$('#nameInput').addEventListener('keydown',e=>{if(e.key==='Enter')$('#saveName').click()});
function addMsg(role,text,meta='',loading=false){$('#chatWelcome').style.display='none';const d=document.createElement('div');d.className='msg '+role;d.innerHTML=`<div class="avatar">${role==='user'?'TÚ':`<img src="data:image/png;base64," alt="A">`}</div><div class="bubble">${loading?'<span class="typing"><i></i><i></i><i></i></span>':esc(text)}${meta?`<div class="meta">${esc(meta)}</div>`:''}</div>`;$('#messages').appendChild(d);$('#messages').scrollTop=$('#messages').scrollHeight;return d}
async function ask(text){go('chat');text=(text||$('#input').value).trim();if(!text)return;$('#input').value='';addMsg('user',text);history.push({role:'user',content:text});sessionStorage.setItem('atomia_history',JSON.stringify(history.slice(-12)));const load=addMsg('assistant','', '',true);try{const r=await fetch('/api/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:text,history:history.slice(-8),name:userName})});const d=await r.json();load.remove();const answer=d.answer||d.error||'No pude responder en este momento.';const meta=d.mode==='online'?'IA ONLINE · GROQ':'MODO LOCAL · ATOM.IA';addMsg('assistant',answer,meta);history.push({role:'assistant',content:answer});history=history.slice(-12);sessionStorage.setItem('atomia_history',JSON.stringify(history))}catch(e){load.remove();addMsg('assistant','No pude comunicarme con el servidor de ATOM.ia. La ESP32 puede estar reiniciándose o fuera de alcance.','CONEXIÓN LOCAL')}}
$('#form').onsubmit=e=>{e.preventDefault();ask()};
function setDot(el,state){el.className='dot '+state}
async function updateStatus(){try{const s=await fetch('/api/status',{cache:'no-store'}).then(r=>r.json());if(s.ai){$('#modePill').textContent='IA ONLINE · GROQ';$('#modePill').className='pill good';setDot($('#netDot'),'ok');$('#netText').textContent='Internet + Groq disponibles';$('#homeStatus').textContent='IA online lista'}else if(s.online){$('#modePill').textContent='INTERNET · IA LOCAL';$('#modePill').className='pill';setDot($('#netDot'),'warn');$('#netText').textContent='Internet conectado · Groq no disponible';$('#homeStatus').textContent='Modo local disponible'}else{$('#modePill').textContent='MODO LOCAL';$('#modePill').className='pill off';setDot($('#netDot'),'bad');$('#netText').textContent='Sin Internet · modo local activo';$('#homeStatus').textContent='Funcionamiento local'}}catch(e){$('#modePill').textContent='SERVIDOR LOCAL';$('#modePill').className='pill off';setDot($('#netDot'),'bad');$('#netText').textContent='Reintentando conexión con ESP32'}
 try{const a=await fetch('/api/archbot/status',{cache:'no-store'}).then(r=>r.json());const on=!!a.connected;$('#botPill').textContent=on?'ARCHBOT ONLINE':'ARCHBOT OFFLINE';$('#botPill').className='pill '+(on?'good':'off');setDot($('#botDot'),on?'ok':'bad');$('#botText').textContent=on?'ATOM-ArchBot conectado':'ATOM-ArchBot sin enlazar';$('#abConnected').textContent=on?'CONECTADO':'DESCONECTADO';$('#abState').textContent=a.state||'ESPERANDO';$('#abIp').textContent=a.ip||'—';$('#abEvent').textContent=a.event||0;$('#abObject').textContent=a.object||'NINGUNO';const c=Number(a.confidence||0);$('#abConfidence').textContent=c+'%';$('#ring').style.background=`conic-gradient(var(--wine) ${c*3.6}deg,#eadfd7 0deg)`;$('#abExplain').textContent=(a.event&&a.object&&a.object!=='NINGUNO')?`ATOM-ArchBot registró una coincidencia visual con ${c}% de confianza. Esto no confirma por sí solo que sea un hallazgo arqueológico.`:'Cuando ATOM-ArchBot confirme una coincidencia visual, aparecerá aquí automáticamente.';if(on&&a.event&&a.event!==lastEvent){if(lastEvent!==0)toast(`Nuevo posible hallazgo: ${a.object} · ${c}%`);lastEvent=a.event}}catch(e){}
}
function toast(t){const x=document.createElement('div');x.className='toast';x.textContent=t;document.body.appendChild(x);setTimeout(()=>x.remove(),3300)}
if(userName){setName(userName);if(history.length){history.forEach(m=>{if(m&&['user','assistant'].includes(m.role)&&m.content)addMsg(m.role,m.content,m.role==='assistant'?'HISTORIAL DE SESIÓN':'')})}}else setTimeout(()=>{$('#nameModal').classList.remove('hidden');$('#nameInput').focus()},220);
setInterval(updateStatus,1500);updateStatus();
document.addEventListener('keydown',e=>{const altGr=e.key==='AltGraph'||(e.code==='AltRight'&&e.ctrlKey&&e.altKey);if(altGr){e.preventDefault();newSession()}});
</script>
</body></html>
