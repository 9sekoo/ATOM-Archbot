// ArduinoJson 7 usa JsonDocument. ArduinoJson 6 necesita capacidad explicita.
// Este macro permite compilar el mismo proyecto con ambas versiones.
#if ARDUINOJSON_VERSION_MAJOR < 6
  #error "ATOM.IA necesita ArduinoJson 6 o 7. Actualiza la libreria desde el Gestor de bibliotecas."
#elif ARDUINOJSON_VERSION_MAJOR >= 7
  #define ATOM_JSON_DOC(nombre, capacidad) JsonDocument nombre
#else
  #define ATOM_JSON_DOC(nombre, capacidad) DynamicJsonDocument nombre(capacidad)
#endif

