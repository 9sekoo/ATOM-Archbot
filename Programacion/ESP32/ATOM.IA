const char SYSTEM_PROMPT[] PROGMEM = R"PROMPT(
Eres ATOM.ia, el asistente digital de ATOM-ArchBot, proyecto escolar de Los Harneritos de San Fernando, Chile.

El eslogan oficial es: “ATOM.ia: el futuro al servicio del pasado”. Úsalo solo cuando sea pertinente, sin repetirlo innecesariamente.

Responde en español latinoamericano claro, natural y fácil de entender. Puedes responder preguntas generales de ciencia, historia, matemáticas, tecnología, cultura, lenguaje y temas cotidianos. Por defecto responde en 60 a 120 palabras; amplía solo cuando la persona lo solicite o el tema realmente lo necesite.

ATOM-ArchBot busca apoyar el harneado arqueológico mediante automatización, sensores y visión computacional. Puede avisar de una coincidencia visual de interés, pero no autentica piezas ni reemplaza a profesionales. Los Harneritos son Benjamín Martínez, Emily Agurto e Ignacio; su profesor/coach es Felipe González.

Si hablas de una detección, usa expresiones como “posible hallazgo”, “objeto de interés” o “coincidencia visual”, y explica que el porcentaje es confianza del clasificador. Si la persona responde que quiere saber más después de una detección, identifica el objeto desde los mensajes recientes y explica qué rasgos deberían compararse —material, forma, técnica, desgaste y contexto— para evaluar la hipótesis. Aclara que una cámara no determina autenticidad, cultura, fecha ni procedencia; la confirmación corresponde a un profesional competente y un análisis de laboratorio solo se menciona cuando sea pertinente. No inventes datos ni fuentes. Si una pregunta depende de información reciente que no puedes verificar, indícalo. No reveles proveedor, modelo, API ni detalles internos salvo que te lo pregunten expresamente. Mantén continuidad con los mensajes recientes.
)PROMPT";

const char* objectNameFromId(uint16_t id) {
  switch (id) {
    case 1: return "SELLO CILINDRICO";
    case 2: return "PUNTA DE PROYECTIL";
    case 3: return "MOAI";
    case 4: return "CABALLO LATTARA";
    case 5: return "FIGURA HNEFATAFL BALDURSHEIMUR";
    case 6: return "OBJETO 6";
    default: return "NINGUNO";
  }
}

void ledFisico(bool on) { digitalWrite(LED_PIN, on ? HIGH : LOW); ledEncendido = on; }
void actualizarLed() {
  uint32_t ahora = millis();
  if (estadoLed == LED_TODO_OK) { ledFisico(true); return; }
  if (estadoLed == LED_ARRANCANDO) {
    if (ahora - ultimoCambioLed >= 150) { ultimoCambioLed = ahora; ledFisico(!ledEncendido); }
    return;
  }
  if (estadoLed == LED_INTERNET_SIN_GROQ) {
    if (ahora - ultimoCambioLed >= 700) { ultimoCambioLed = ahora; ledFisico(!ledEncendido); }
    return;
  }
  uint32_t fase = ahora % 1800;
  ledFisico(fase < 120 || (fase >= 260 && fase < 380));
}

void cargarGroqKey() {
  preferences.begin("atomia", true);
  groqKey = preferences.getString("key", "");
  preferences.end();
  Serial.print("API Key Groq: "); Serial.println(groqKey.length() > 10 ? "ENCONTRADA" : "NO ENCONTRADA");
}

bool iaOnlineReciente() {
  if (WiFi.status() != WL_CONNECTED) return false;
  if (groqKey.length() <= 10 || groqAuthError) return false;
  if (ultimoChatFalloMs != 0 && millis() - ultimoChatFalloMs < IA_RECOVERY_STATE_MS) return false;

  if (groqAutorizado) return true;
  if (ultimoGroqOkMs != 0 && millis() - ultimoGroqOkMs < GROQ_READY_STALE_MS) return true;
  return false;
}



bool archbotOnline() { return archbotSeen && (millis()-archbotLastSeen < ARCHBOT_TIMEOUT_MS); }
void markArchbotSeen() { archbotSeen=true; archbotLastSeen=millis(); archbotIp=server.client().remoteIP().toString(); }
bool autenticarArchbot() {
  if (!server.hasHeader("X-ATOM-Key") || server.header("X-ATOM-Key") != ARCHBOT_TOKEN) {
    server.send(401,"application/json","{\"ok\":false,\"error\":\"No autorizado\"}"); return false;
  }
  return true;
}
void handleArchbotHeartbeat() {
  enviarNoCache();
  if(!autenticarArchbot()) return;
  markArchbotSeen(); archbotState="CONECTADO";
  ATOM_JSON_DOC(out, 256); out["ok"]=true; out["server"]="ATOM.ia"; out["groq"]=iaOnlineReciente();
  String r; serializeJson(out,r); server.send(200,"application/json",r);
}
bool eventoYaVisto(uint32_t evento){
  for(uint8_t i=0;i<12;i++){
    if(eventosRecientes[i]==evento) return true;
  }
  return false;
}

void registrarEventoVisto(uint32_t evento){
  eventosRecientes[indiceEventoReciente]=evento;
  indiceEventoReciente=(indiceEventoReciente+1)%12;
}

void handleArchbotEvent() {
  enviarNoCache();
  if(!autenticarArchbot()) return;
  ultimoEventoRecibidoMs=millis();
  if(!server.hasArg("plain") || server.arg("plain").length()>MAX_EVENT_BODY){server.send(400,"application/json","{\"ok\":false}");return;}
  ATOM_JSON_DOC(input, 512); if(deserializeJson(input,server.arg("plain"))){server.send(400,"application/json","{\"ok\":false}");return;}
  uint16_t estado=input["estado"]|0, id=input["objeto_id"]|0, confianza=input["confianza"]|0; uint32_t evento=input["evento"]|0UL;
  if(estado!=1 || id<1 || id>6 || confianza>100 || evento==0){server.send(400,"application/json","{\"ok\":false,\"error\":\"Datos invalidos\"}");return;}
  markArchbotSeen(); archbotObjectId=id; archbotConfidence=confianza; archbotObject=objectNameFromId(id); archbotState="HALLAZGO";
  bool nuevo=!eventoYaVisto(evento);
  if(nuevo){
    registrarEventoVisto(evento);
    archbotLastEvent=evento;
    Serial.printf("[ARCHBOT] Posible hallazgo #%lu | %s | %u%%\n",(unsigned long)evento,archbotObject.c_str(),confianza);
  }
  ATOM_JSON_DOC(out, 256); out["ok"]=true; out["nuevo"]=nuevo; out["evento"]=evento; String r; serializeJson(out,r); server.send(200,"application/json",r);
}
void handleArchbotStatus() {
  bool online = archbotOnline();

  ATOM_JSON_DOC(out, 768);
  out["connected"]=online;
  out["ever_seen"]=archbotSeen;
  out["ap_active"]=(WiFi.softAPIP()[0] != 0);
  out["ap_clients"]=WiFi.softAPgetStationNum();
  out["state"]=online?archbotState:(archbotSeen?"DESCONECTADO":"ESPERANDO");
  out["ip"]=archbotIp;
  out["object_id"]=archbotObjectId;
  out["object"]=archbotObject;
  out["confidence"]=archbotConfidence;
  out["event"]=archbotLastEvent;

  String r;
  serializeJson(out,r);

  server.sendHeader("Cache-Control","no-store, no-cache, must-revalidate, max-age=0");
  server.sendHeader("Pragma","no-cache");
  server.sendHeader("Connection","close");
  server.send(200,"application/json; charset=utf-8",r);
}


void handleDiscovery() {
  int packetSize=discoveryUdp.parsePacket(); if(!packetSize)return;
  char buffer[64]={0}; int len=discoveryUdp.read(buffer,sizeof(buffer)-1); if(len<=0)return;
  String msg(buffer); msg.trim(); if(msg!="ATOM_IA_DISCOVER")return;
  IPAddress remote=discoveryUdp.remoteIP(); String ipReply;
  if(remote[0]==192 && remote[1]==168 && remote[2]==4) ipReply=WiFi.softAPIP().toString();
  else ipReply=WiFi.localIP().toString();
  String reply="ATOM_IA:"+ipReply; discoveryUdp.beginPacket(remote,discoveryUdp.remotePort()); discoveryUdp.print(reply); discoveryUdp.endPacket();
}

String norm(String s){s.toLowerCase();s.replace("á","a");s.replace("é","e");s.replace("í","i");s.replace("ó","o");s.replace("ú","u");s.replace("ñ","n");return s;}
void sendOffline(const String& answer){ATOM_JSON_DOC(out, 2048);out["answer"]=answer;out["mode"]="offline";String r;serializeJson(out,r);server.send(200,"application/json; charset=utf-8",r);}
void sendProject(const String& answer){ATOM_JSON_DOC(out, 2048);out["answer"]=answer;out["mode"]="project";String r;serializeJson(out,r);server.send(200,"application/json; charset=utf-8",r);}

bool consultaProyectoLocalPrioritaria(const String& message){
  String q=norm(message);
  q.trim();
  bool interaccionComun =
    q.indexOf("hola")==0 || q=="buenas" || q.indexOf("buenos dias")==0 ||
    q.indexOf("buenas tardes")==0 || q.indexOf("buenas noches")==0 ||
    q.indexOf("gracias")>=0 || q.indexOf("quien eres")>=0 ||
    q.indexOf("que puedes hacer")>=0 || q=="ayuda" || q.indexOf("ayudame")>=0;
  if(interaccionComun) return true;

  bool hablaDelProyecto =
    q.indexOf("atom")>=0 || q.indexOf("archbot")>=0 || q.indexOf("harnerito")>=0 ||
    q.indexOf("proyecto")>=0 || q.indexOf("robot")>=0 ||
    q.indexOf("matrix")>=0 || q.indexOf("m-vision")>=0 || q.indexOf("mvision")>=0 ||
    q.indexOf("benjamin")>=0 || q.indexOf("emily")>=0 || q.indexOf("ignacio")>=0 ||
    q.indexOf("felipe")>=0 || q.indexOf("karla")>=0 || q.indexOf("coach")>=0 ||
    q.indexOf("tutor")>=0 || q.indexOf("arqueologa")>=0;
  if(hablaDelProyecto) return true;

  if(q.indexOf("moai")>=0 || q.indexOf("sello")>=0 || q.indexOf("punta")>=0 || q.indexOf("proyectil")>=0 || q.indexOf("lattara")>=0 || q.indexOf("hnefatafl")>=0 || q.indexOf("baldursheimur")>=0) return true;
  if(q.indexOf("wro")>=0 || q.indexOf("regional")>=0 || q.indexOf("segundo lugar")>=0) return true;
  return false;
}

void offlineFallback(const String& message){
  String q=norm(message);
  q.trim();
  if(q.indexOf("hola")==0 || q=="buenas" || q.indexOf("buenos dias")==0 || q.indexOf("buenas tardes")==0 || q.indexOf("buenas noches")==0){
    sendOffline("¡Hola! Soy ATOM.ia. Puedo explicarte cómo funciona ATOM-ArchBot, quiénes son Los Harneritos, qué problema busca abordar el proyecto y cómo interpreta sus posibles hallazgos. También puedo conversar sobre otros temas cuando el servicio de IA online está disponible.");
    return;
  }
  if(q.indexOf("gracias")>=0){
    sendOffline("¡De nada! Puedes seguir preguntándome sobre ATOM-ArchBot, el equipo, sus componentes, las detecciones o cualquier parte del proyecto.");
    return;
  }
  if(q.indexOf("quien eres")>=0 || q.indexOf("que puedes hacer")>=0 || q=="ayuda" || q.indexOf("ayudame")>=0){
    sendOffline("Soy ATOM.ia, la interfaz educativa y conversacional de Los Harneritos. Presento la telemetría de ATOM-ArchBot, explico sus detecciones con responsabilidad, conservo el historial de la sesión y respondo preguntas sobre el proyecto. Para temas generales puedo ampliar mis respuestas mediante un servicio de IA online cuando está disponible.");
    return;
  }
  if(q.indexOf("chiste")>=0){
    sendOffline("¿Por qué el robot arqueólogo nunca pierde la paciencia? Porque siempre sabe que todo es cuestión de capas.");
    return;
  }
  if(q.indexOf("moai")>=0){sendProject("El MOÁI está incorporado al catálogo de referencia de ATOM.ia como ID 3. La ficha del equipo lo sitúa en Rano Raraku, Rapa Nui, asociado al pueblo Rapanui y tallado en toba volcánica. Una detección automática solo sería una coincidencia visual y requeriría revisión humana.");return;}
  if(q.indexOf("sello")>=0){sendProject("El SELLO CILÍNDRICO es el ID 1 del catálogo. La ficha del equipo lo vincula a la cultura Mochica y describe su uso para estampar diseños sobre materiales como arcilla húmeda. Su detección por ATOM-ArchBot sería solo una coincidencia visual.");return;}
  if(q.indexOf("punta")>=0 || q.indexOf("proyectil")>=0){sendProject("La PUNTA DE PROYECTIL es el ID 2 del catálogo. La ficha del equipo la relaciona con Cueva Fell, Magallanes, y con grupos cazadores-recolectores. Puede aportar información sobre técnicas de caza y adaptación al entorno; una detección automática no autentica la pieza.");return;}
  if(q.indexOf("lattara")>=0 || q.indexOf("caballo")>=0){sendProject("El CABALLO LATTARA es el ID 4 del catálogo de referencia. La ficha del equipo lo describe como una figurilla cerámica estilizada del Neolítico final en Lattara, Francia, posiblemente de carácter simbólico o ritual.");return;}
  if(q.indexOf("hnefatafl")>=0 || q.indexOf("baldursheimur")>=0){sendProject("La FIGURA HNEFATAFL BALDURSHEIMUR es el ID 5 del catálogo interno del proyecto. Para esta pieza ATOM.ia debe limitarse a la ficha entregada por el equipo y no completar datos históricos que no estén confirmados.");return;}
  if(q.indexOf("felipe")>=0 || q.indexOf("coach")>=0 || q.indexOf("tutor")>=0){sendProject("Felipe González es el profesor y coach de Los Harneritos. Guía la planificación, acompaña las decisiones técnicas y las pruebas, ayuda a ordenar el aprendizaje del equipo y apoya la preparación y comunicación de ATOM-ArchBot para la competencia. Su función es orientar el proceso para que los estudiantes investiguen, construyan, documenten y expliquen sus propias decisiones.");return;}
  if(q.indexOf("karla")>=0 || q.indexOf("arqueologa")>=0){sendProject("Karla Carrasco es una arqueóloga con quien el equipo ha tenido orientación relacionada con arqueología y patrimonio. Esa orientación ayuda al proyecto, pero no significa que ATOM-ArchBot esté certificado profesionalmente.");return;}
  if(q.indexOf("fuente")>=0){sendProject("La información de ATOM.ia se organiza en tres niveles. Para normativa y protección del patrimonio chileno se consideran principalmente la Biblioteca del Congreso Nacional de Chile y el Consejo de Monumentos Nacionales. Para contexto educativo se utilizan instituciones como el Museo Chileno de Arte Precolombino, y para la competencia se considera el marco de World Robot Olympiad Association.\n\nLos datos técnicos de ATOM-ArchBot provienen de la documentación interna de Los Harneritos: bitácoras, diseños CAD, programación, fotografías, pruebas de sensores, resultados de visión y observaciones de cada versión. También se incorporan entrevistas, encuestas y orientación recibida por el equipo. ATOM.ia diferencia estos antecedentes y evita presentar como oficial o comprobado aquello que corresponde solamente al prototipo.");return;}
  if((q.indexOf("como funciona")>=0 || q.indexOf("funcionamiento")>=0 || q.indexOf("como trabaja")>=0 || q.indexOf("como opera")>=0) && (q.indexOf("atom")>=0 || q.indexOf("archbot")>=0 || q.indexOf("proyecto")>=0)){sendProject("ATOM-ArchBot funciona como un sistema de tres capas que trabajan coordinadas.\n\n1. Visión: la cámara M-Vision observa el material y compara la imagen con las categorías aprendidas. Cuando encuentra una semejanza suficientemente estable, genera una coincidencia visual con un identificador y un porcentaje de confianza.\n\n2. Control: MATRIX Mini R4 recibe esa información y coordina el comportamiento del prototipo. También controla motores, servos, sensores, señales luminosas, pantallas y las condiciones de seguridad del movimiento.\n\n3. Comunicación: MATRIX envía estados y eventos a la ESP32. La ESP32 mantiene la página local de ATOM.ia, presenta la telemetría, registra la detección durante la sesión y explica qué podría significar. Para preguntas generales puede utilizar un servicio de IA mediante un canal externo de Internet, pero el control del robot no depende de ese servicio.\n\nEn una detección, el sistema no afirma que encontró una pieza auténtica: solo advierte una coincidencia para que el objeto y su contexto sean revisados por una persona capacitada. Así, la tecnología apoya la observación sin reemplazar el criterio arqueológico profesional.");return;}
  if((q.indexOf("problema")>=0 || q.indexOf("resolver")>=0 || q.indexOf("necesidad")>=0) && (q.indexOf("atom")>=0 || q.indexOf("archbot")>=0 || q.indexOf("proyecto")>=0)){sendProject("ATOM-ArchBot nace a partir de un problema concreto: el harneado arqueológico puede ser repetitivo, físicamente exigente y requiere mantener mucha atención para no pasar por alto materiales importantes. En trabajos asociados a plazos de construcción o rescate patrimonial también existe presión por avanzar, pero acelerar sin observar correctamente puede significar perder información sobre el contexto de un objeto.\n\nLa propuesta de Los Harneritos es automatizar parte del movimiento del harnero, apoyar la supervisión mediante sensores y utilizar visión computacional como una segunda alerta. Si aparece una coincidencia visual, el sistema puede registrarla y comunicarla para que sea revisada antes de continuar.\n\nEl objetivo no es reemplazar arqueólogos ni decidir qué objeto es valioso. Busca reducir trabajo repetitivo, mejorar la continuidad de la observación y demostrar cómo la robótica puede contribuir al cuidado del patrimonio cuando se utiliza con límites claros y supervisión humana.");return;}
  bool hablaDelProyecto = q.indexOf("atom")>=0 || q.indexOf("archbot")>=0 || q.indexOf("robot")>=0 || q.indexOf("proyecto")>=0 || q.indexOf("matrix")>=0 || q.indexOf("m-vision")>=0 || q.indexOf("mvision")>=0 || q.indexOf("harnerito")>=0 || q.indexOf("benjamin")>=0 || q.indexOf("emily")>=0 || q.indexOf("ignacio")>=0;
  if(hablaDelProyecto && (q.indexOf("impacto")>=0 || q.indexOf("beneficio")>=0 || q.indexOf("sociedad")>=0 || q.indexOf("aporte")>=0)){sendProject("ATOM-ArchBot podría aportar en cuatro áreas principales. Primero, reducir parte del esfuerzo repetitivo del harneado mediante movimiento automatizado. Segundo, mantener una observación constante con sensores y visión computacional, generando una alerta cuando aparece una semejanza que merece revisión. Tercero, conservar un registro de la sesión para que el equipo pueda revisar qué ocurrió, cuándo ocurrió y con qué confianza visual.\n\nTambién posee un valor educativo: permite explicar de manera visible cómo se relacionan mecánica, electrónica, programación, inteligencia artificial, arqueología y conservación del patrimonio. Para Los Harneritos, el desarrollo ha significado investigar, entrevistar personas, diseñar distintas versiones, documentar errores y aprender a comunicar resultados con responsabilidad.\n\nEstos son beneficios esperados de un prototipo y todavía necesitan validación mediante pruebas y opinión profesional. El sistema no autentica objetos, no determina su antigüedad y no reemplaza el trabajo de arqueólogos o conservadores.");return;}
  if(hablaDelProyecto && (q.indexOf("comunica")>=0 || q.indexOf("conexion")>=0 || q.indexOf("conecta")>=0 || q.indexOf("internet")>=0)){sendProject("La comunicación está separada para mantener estable el proyecto. M-Vision analiza la imagen y envía la coincidencia a MATRIX Mini R4. MATRIX controla el robot y transmite a la ESP32 su estado, señales periódicas y nuevos eventos. La ESP32 crea la red directa ATOM-ARCHBOT, recibe la telemetría y publica esta interfaz en 192.168.4.1.\n\nEn paralelo, la ESP32 puede utilizar un canal independiente de acceso a Internet para ampliar preguntas generales. Ese canal no controla motores ni detecciones. Si el servicio externo se interrumpe, MATRIX, la página local, el historial de la sesión y las respuestas esenciales del proyecto permanecen disponibles.");return;}
  if(hablaDelProyecto && (q.indexOf("componente")>=0 || q.indexOf("sensor")>=0 || q.indexOf("motor")>=0 || q.indexOf("placa")>=0)){sendProject("La versión actual separa el sistema en módulos. MATRIX Mini R4 funciona como controlador principal; M-Vision/OpenMV realiza el análisis visual; los servos mueven el harnero; los motores DC desplazan la bandeja; y el final de carrera ayuda a detenerla en una posición segura. También se integran botones, pantallas, señalización RGB, buzzer y sensores láser para interacción y supervisión.\n\nLa ESP32 trabaja como servidor e interfaz: crea la red local de ATOM.ia, recibe los eventos de MATRIX, presenta el estado del prototipo y consulta la IA online cuando está disponible. Esta separación evita que una falla de Internet detenga el control principal del robot.");return;}
  if(((q.indexOf("quienes")>=0 || q.indexOf("integrantes")>=0 || q.indexOf("equipo")>=0) && q.indexOf("harnerito")>=0) || q.indexOf("benjamin")>=0 || q.indexOf("emily")>=0 || q.indexOf("ignacio")>=0){sendProject("Los Harneritos son Benjamín Martínez, Emily Agurto e Ignacio, estudiantes del Liceo Heriberto Soto Soto de San Fernando. El equipo desarrolla ATOM-ArchBot combinando distintas responsabilidades.\n\nBenjamín participa en diseño mecánico, CAD, fabricación, integración de sensores, visión computacional y pruebas del prototipo. Emily trabaja en investigación, antecedentes, entrevistas, contenidos y comunicación del problema y su posible impacto. Ignacio aporta en programación, electrónica, actuadores e integración funcional.\n\nEl profesor Felipe González es su coach: orienta la planificación, acompaña decisiones técnicas y pruebas, ayuda a ordenar el aprendizaje y apoya la preparación del proyecto para la competencia. Las decisiones y la construcción continúan siendo realizadas y explicadas por los estudiantes.");return;}
  if(hablaDelProyecto && (q.indexOf("detecta")>=0 || q.indexOf("reconoce")>=0 || q.indexOf("hallazgo")>=0 || q.indexOf("que objetos")>=0)){sendProject("ATOM-ArchBot trabaja actualmente con cinco categorías visuales de referencia: sello cilíndrico, punta de proyectil, moái, caballo Lattara y figura Hnefatafl Baldursheimur. La cámara no identifica directamente la autenticidad de una pieza; compara formas, colores y patrones con ejemplos usados durante el entrenamiento.\n\nPara evitar avisos repetidos, la coincidencia debe mantenerse durante varios cuadros y el sistema se rearma después de que el objeto desaparece. Cuando se confirma visualmente, MATRIX envía a la ESP32 la categoría, el porcentaje de confianza y un número de evento. ATOM.ia muestra una imagen de referencia, registra el evento durante la sesión y explica qué características deberían revisarse.\n\nEl porcentaje representa semejanza con el modelo, no antigüedad ni valor arqueológico. La conclusión siempre requiere una persona capacitada y, si corresponde, análisis especializado.");return;}
  if(q.indexOf("version")>=0 || q.indexOf("v1")>=0 || q.indexOf("v2")>=0 || q.indexOf("v3")>=0){sendProject("ATOM-ArchBot ha evolucionado por varias versiones: V1 probó el concepto con Arduino Uno y servos; V2 amplió motores, electrónica y visión con ESP32/ESP32-CAM pero fue más compleja; V3/V3.x usa MATRIX Mini R4 y M-Vision/OpenMV, además de servos, motores DC, final de carrera, sensores láser, pantallas, RGB y buzzer.");return;}
  if(q.indexOf("segundo lugar")>=0 || q.indexOf("regional")>=0 || q.indexOf("wro")>=0){sendProject("Los Harneritos obtuvieron 2.º lugar regional en WRO/Futuros Innovadores el 31 de julio de 2026. ATOM-ArchBot siguió en desarrollo después de esa instancia.");return;}
  if(hablaDelProyecto && (q.indexOf("que es")>=0 || q.indexOf("cuentame")>=0 || q.indexOf("hablame")>=0 || q.indexOf("explica")>=0)){sendProject("ATOM-ArchBot es un prototipo de robótica educativa desarrollado por Los Harneritos para investigar cómo la automatización puede apoyar el harneado arqueológico y el cuidado del patrimonio. Su propuesta combina movimiento mecánico, sensores, visión computacional y una interfaz explicativa.\n\nMATRIX Mini R4 coordina las funciones principales del robot, mientras M-Vision observa el material y busca semejanzas con las categorías de su entrenamiento. Cuando detecta una coincidencia estable, el evento llega a la ESP32 y ATOM.ia muestra la categoría sugerida, el porcentaje de confianza y una explicación responsable para los visitantes.\n\nEl proyecto busca disminuir parte del esfuerzo repetitivo, apoyar la atención y evitar que una observación se pierda durante la demostración. Sin embargo, una detección es solamente una hipótesis visual: no confirma autenticidad, antigüedad, cultura ni procedencia. Cualquier posible hallazgo necesita revisión profesional y, cuando corresponda, análisis especializado.");return;}
  if(hablaDelProyecto){sendProject("ATOM-ArchBot es el ecosistema tecnológico de Los Harneritos para explorar cómo la robótica puede apoyar el harneado arqueológico. MATRIX Mini R4 controla el prototipo, M-Vision analiza imágenes y la ESP32 ejecuta ATOM.ia para presentar telemetría, registrar eventos y explicar el proyecto.\n\nEl sistema puede advertir una coincidencia visual y conservarla durante la sesión, pero no autentica objetos ni reemplaza el criterio de profesionales de la arqueología y la conservación. Su valor está en reducir trabajo repetitivo, apoyar la observación y acercar tecnología y patrimonio de una manera educativa y responsable.");return;}
  sendOffline("Estoy funcionando en modo local. Puedo responder sobre ATOM-ArchBot, Los Harneritos, Felipe González, sus versiones, funcionamiento, objetivos y fuentes. Para preguntas generales necesito recuperar la conexión con la IA online.");
}

String construirPayloadChat(const String& message, JsonArray history, const String& visitorName) {
  ATOM_JSON_DOC(req, 8192);
  req["model"] = GROQ_MODEL_PRIMARY;
  req["temperature"] = 0.60;
  req["top_p"] = 0.95;
  req["max_completion_tokens"] = GROQ_PRIMARY_MAX_TOKENS;
  req["reasoning_effort"] = "low";
  req["include_reasoning"] = false;
  req["stream"] = false;

  JsonArray msgs = req["messages"].to<JsonArray>();

  JsonObject sys = msgs.add<JsonObject>();
  sys["role"] = "system";
  sys["content"] = FPSTR(SYSTEM_PROMPT);

  if (visitorName.length()) {
    JsonObject who = msgs.add<JsonObject>();
    who["role"] = "system";
    who["content"] = "La persona que usa esta sesión se llama " + visitorName + ". Usa su nombre solo cuando resulte natural.";
  }

  int total = history.size();
  int start = total > 3 ? total - 3 : 0;

  for (int i = start; i < total; i++) {
    JsonObject item = history[i];
    String role = item["role"] | "";
    String content = item["content"] | "";
    if (role != "user" && role != "assistant") continue;
    content.trim();
    if (!content.length()) continue;
    if (content.length() > 300) content = content.substring(0, 300);
    if (i == total - 1 && role == "user" && content == message) continue;

    JsonObject m = msgs.add<JsonObject>();
    m["role"] = role;
    m["content"] = content;
  }

  JsonObject usr = msgs.add<JsonObject>();
  usr["role"] = "user";
  usr["content"] = message;

  String payload;
  payload.reserve(4700);
  serializeJson(req, payload);
  return payload;
}



bool resolverGroqIP(bool forzar = false) {
  if (WiFi.status() != WL_CONNECTED) return false;

  if (
    !forzar &&
    groqIpValida &&
    millis() - groqIpResueltaMs < GROQ_DNS_REFRESH_MS
  ) {
    return true;
  }

  IPAddress ip;
  int ok = WiFi.hostByName(GROQ_HOST, ip);

  if (ok == 1 && ip[0] != 0) {
    groqIpCache = ip;
    groqIpValida = true;
    groqIpResueltaMs = millis();

    Serial.print("Groq DNS: ");
    Serial.println(groqIpCache);
    return true;
  }

  groqIpValida = false;
  ultimoGroqError = "DNS";
  Serial.println("Groq DNS: fallo");
  return false;
}

bool extraerRespuestaGroq(const String& body, String& answer) {
  answer = "";

  ATOM_JSON_DOC(filter, 768);
  filter["choices"][0]["message"]["content"] = true;
  filter["choices"][0]["finish_reason"] = true;
  filter["usage"]["completion_tokens"] = true;
  filter["usage"]["completion_tokens_details"]["reasoning_tokens"] = true;
  filter["error"]["message"] = true;

  ATOM_JSON_DOC(incoming, 6144);
  DeserializationError err = deserializeJson(
    incoming,
    body,
    DeserializationOption::Filter(filter)
  );

  if (err) {
    ultimoGroqError = "JSON";
    Serial.print("Groq JSON: ");
    Serial.println(err.c_str());
    return false;
  }

  ultimoGroqFinishReason = incoming["choices"][0]["finish_reason"] | "";
  ultimoGroqCompletionTokens = incoming["usage"]["completion_tokens"] | 0;
  ultimoGroqReasoningTokens = incoming["usage"]["completion_tokens_details"]["reasoning_tokens"] | 0;

  answer = incoming["choices"][0]["message"]["content"] | "";
  answer.trim();

  if (!answer.length()) {
    String apiError = incoming["error"]["message"] | "";
    if (apiError.length()) {
      ultimoGroqError = "API";
      Serial.print("Groq API: ");
      Serial.println(apiError);
    } else {
      ultimoGroqError = (ultimoGroqFinishReason == "length") ? "SALIDA_AGOTADA" : "RESPUESTA_VACIA";
    }
    return false;
  }

  ultimoGroqError = "";
  ultimoGroqOkMs = millis();
  ultimoChatOkMs = millis();
  groqAutorizado = true;
  groqAuthError = false;
  groqFallosTransitorios = 0;
  groqRateLimitUntilMs = 0;
  groqFuncionando = true;
  return true;
}


String payloadParaIntento(
  const String& payloadOriginal,
  const char* modelo,
  uint32_t maxTokens
) {
  String p = payloadOriginal;
  p.reserve(payloadOriginal.length() + 80);

  String modeloOriginal = String("\"model\":\"") + GROQ_MODEL_PRIMARY + "\"";
  String modeloNuevo = String("\"model\":\"") + modelo + "\"";
  p.replace(modeloOriginal, modeloNuevo);

  String tokensOriginal = String("\"max_completion_tokens\":") + String(GROQ_PRIMARY_MAX_TOKENS);
  String tokensNuevo = String("\"max_completion_tokens\":") + String(maxTokens);
  p.replace(tokensOriginal, tokensNuevo);

  return p;
}


uint32_t parseSegundosHeader(const String& raw) {
  if (!raw.length()) return 0;
  float segundos = raw.toFloat();
  if (segundos <= 0) return 0;
  uint32_t ms = (uint32_t)(segundos * 1000.0f);
  return ms;
}

ResultadoGroq groqPostHttp(
  const String& payload,
  const char* modelo,
  uint32_t timeoutMs
) {
  ResultadoGroq out;
  out.code = -1;
  uint32_t inicio = millis();
  ultimoGroqModelo = modelo;

  if (WiFi.status() != WL_CONNECTED) {
    out.error = "SIN_WIFI";
    ultimoGroqError = out.error;
    return out;
  }

  resolverGroqIP(false);

  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(timeoutMs);

  HTTPClient https;
  if (!https.begin(client, "https://api.groq.com/openai/v1/chat/completions")) {
    out.error = "HTTP_BEGIN";
    out.code = -22;
    ultimoGroqError = out.error;
    client.stop();
    return out;
  }

  const char* hdrs[] = {
    "retry-after",
    "x-ratelimit-remaining-tokens",
    "x-ratelimit-reset-tokens",
    "x-request-id"
  };
  https.collectHeaders(hdrs, 4);
  https.setConnectTimeout(8000);
  https.setTimeout(timeoutMs);
  https.setReuse(false);
  https.setUserAgent("ATOM-IA-ESP32/DIRECTO-V3");
  https.setAcceptEncoding("identity");
  https.addHeader("Content-Type", "application/json");
  https.addHeader("Accept", "application/json");
  https.addHeader("Authorization", "Bearer " + groqKey);
  https.addHeader("Connection", "close");

  Serial.print("Groq HTTPS · modelo ");
  Serial.println(modelo);

  out.code = https.POST(payload);
  ultimoGroqHttp = out.code;

  ultimoGroqRetryAfter = https.header("retry-after");
  ultimoGroqRemainingTokens = https.header("x-ratelimit-remaining-tokens");
  ultimoGroqResetTokens = https.header("x-ratelimit-reset-tokens");
  ultimoGroqRequestId = https.header("x-request-id");

  out.retryAfterMs = parseSegundosHeader(ultimoGroqRetryAfter);
  if (out.retryAfterMs == 0 && out.code == 429) {
    out.retryAfterMs = parseSegundosHeader(ultimoGroqResetTokens);
  }

  String body;
  if (out.code > 0) {
    int expected = https.getSize();
    if (expected > 0 && expected < 16000) body.reserve(expected + 16);
    body = https.getString();
  }

  https.end();
  client.stop();
  out.durationMs = millis() - inicio;
  ultimoGroqDuracionMs = out.durationMs;

  if (out.code >= 200 && out.code < 300) {
    String answer;
    if (extraerRespuestaGroq(body, answer)) {
      out.ok = true;
      out.answer = answer;
      out.error = "";
      return out;
    }
    out.error = ultimoGroqError;
    return out;
  }

  if (out.code == 401) {
    groqAuthError = true;
    groqAutorizado = false;
    groqFuncionando = false;
    out.error = "API_KEY";
  } else if (out.code == 403) {
    out.error = "PERMISO_MODELO";
  } else if (out.code == 429) {
    out.error = "RATE_LIMIT";
    groqRateLimitUntilMs = millis() + out.retryAfterMs;
  } else if (out.code > 0) {
    out.error = "HTTP_" + String(out.code);
  } else {
    out.error = "TRANSPORTE_" + String(out.code);
    groqIpValida = false;
  }

  if (body.length() && body.length() < 3000) {
    ATOM_JSON_DOC(errDoc, 2048);
    if (!deserializeJson(errDoc, body)) {
      String msg = errDoc["error"]["message"] | "";
      if (msg.length()) {
        Serial.print("Groq detalle: ");
        Serial.println(msg);
      }
    }
  }

  ultimoGroqError = out.error;
  return out;
}


bool validarGroqAPI() {
  if (WiFi.status() != WL_CONNECTED || groqKey.length() <= 10) return false;

  iaValidacionActiva = true;
  ultimoIntentoValidacionIA = millis();

  WiFiClientSecure client;
  client.setInsecure();
  client.setTimeout(10000);

  HTTPClient https;
  int code = -1;

  if (https.begin(client, GROQ_MODELS_URL)) {
    https.setConnectTimeout(7000);
    https.setTimeout(10000);
    https.setReuse(false);
    https.setUserAgent("ATOM-IA-ESP32/DIRECTO-V3");
    https.setAcceptEncoding("identity");
    https.addHeader("Authorization", "Bearer " + groqKey);
    https.addHeader("Connection", "close");
    code = https.GET();
    ultimoGroqHttp = code;
    https.end();
    client.stop();
  }

  if (code == 200) {
    groqAutorizado = true;
    groqAuthError = false;
    groqFuncionando = true;
    groqFallosTransitorios = 0;
    groqRateLimitUntilMs = 0;
    ultimoGroqError = "";
    ultimoGroqOkMs = millis();
    ultimoChatFalloMs = 0;
    Serial.println("IA ONLINE: API validada");
    iaValidacionActiva = false;
    return true;
  }

  if (code == 401) {
    groqAutorizado = false;
    groqAuthError = true;
    groqFuncionando = false;
    ultimoGroqError = "API_KEY";
  } else {
    if (groqFallosTransitorios < 255) groqFallosTransitorios++;
    ultimoGroqError = (code > 0) ? ("VALIDACION_HTTP_" + String(code)) : ("VALIDACION_RED_" + String(code));
  }

  Serial.print("IA ONLINE: validacion pendiente · ");
  Serial.println(ultimoGroqError);
  iaValidacionActiva = false;
  return false;
}



String respaldoLocalGeneral(const String& message){
  String q = norm(message);
  q.trim();

  if(q=="hola" || q=="holaa" || q=="holaaa" || q=="buenas")
    return "¡Hola! Estoy aquí. La parte local de ATOM.ia sigue funcionando mientras recupero la respuesta online.";

  if(q.indexOf("gracias")>=0)
    return "¡De nada! Puedes seguir preguntándome cuando quieras.";

  if(q.indexOf("chiste")>=0){
    const char* chistes[] = {
      "¿Por qué el robot arqueólogo llevó una escoba? Porque quería barrer con la competencia... sin mover ninguna pieza histórica.",
      "¿Qué le dijo un fósil a otro? Nos vemos en unos cuantos millones de años.",
      "¿Por qué el programador confundió arqueología con depuración? Porque en ambos casos hay que encontrar cosas antiguas enterradas."
    };
    return String(chistes[millis()%3]);
  }

  if(q.indexOf("arqueologia")>=0 || q.indexOf("arqueología")>=0)
    return "La arqueología estudia las sociedades humanas del pasado a partir de sus restos materiales, como herramientas, construcciones, cerámicas y otros objetos. No se trata solo de encontrar piezas: también importa registrar su contexto para poder interpretarlas correctamente.";

  if(q.indexOf("inteligencia artificial")>=0 || q=="que es ia" || q=="qué es ia")
    return "La inteligencia artificial es un conjunto de técnicas que permite a sistemas informáticos realizar tareas como reconocer patrones, entender texto, clasificar imágenes o generar respuestas. No piensa exactamente como una persona: procesa datos y usa modelos para producir resultados.";

  if(q.indexOf("einstein")>=0)
    return "Albert Einstein fue un físico nacido en 1879, conocido especialmente por desarrollar la teoría de la relatividad y por sus aportes a la física moderna. Recibió el Premio Nobel de Física de 1921 por su explicación del efecto fotoeléctrico.";

  return "";
}

void procesarTrabajoIA() {
  String payload;
  String messageOriginal;
  uint32_t jobActual = 0;

  if (iaMutex && xSemaphoreTake(iaMutex, pdMS_TO_TICKS(300)) == pdTRUE) {
    payload = iaJobPayload;
    messageOriginal = iaJobMessage;
    jobActual = iaJobId;
    xSemaphoreGive(iaMutex);
  }

  String result;
  result.reserve(4800);

  ResultadoGroq ultimo;
  bool respondio = false;

  for (uint8_t intento = 0; intento < GROQ_CHAT_RETRIES; intento++) {
    if (WiFi.status() != WL_CONNECTED) {
      ultimo.error = "SIN_WIFI";
      ultimo.code = -10;
      pedirReconexionInternet = true;
      break;
    }

    if (intento == 1) {
      vTaskDelay(pdMS_TO_TICKS(GROQ_MIN_RETRY_DELAY_MS));
    }

    bool falloDeModelo = intento == 1 && (ultimo.code == 403 || ultimo.code == 404);
    const char* modeloIntento = falloDeModelo ? GROQ_MODEL_FALLBACK : GROQ_MODEL_PRIMARY;
    uint32_t presupuestoIntento = intento == 0 ? GROQ_PRIMARY_MAX_TOKENS : GROQ_RETRY_MAX_TOKENS;
    String intentoPayload = payloadParaIntento(payload, modeloIntento, presupuestoIntento);

    Serial.print("IA online · intento ");
    Serial.print(intento + 1);
    Serial.print("/");
    Serial.print(GROQ_CHAT_RETRIES);
    Serial.print(" · ");
    Serial.println(modeloIntento);

    ultimo = groqPostHttp(intentoPayload, modeloIntento, GROQ_CHAT_TIMEOUT_MS);

    if (ultimo.ok) {
      respondio = true;
      break;
    }

    if (ultimo.code == 400 || ultimo.code == 401 || ultimo.code == 429) break;
    if ((ultimo.code == 403 || ultimo.code == 404) && intento >= 1) break;
  }

  if (respondio) {
    groqAutorizado = true;
    groqAuthError = false;
    groqFuncionando = true;
    ultimoChatFalloMs = 0;
    estadoLed = LED_TODO_OK;

    ATOM_JSON_DOC(out, 6144);
    out["answer"] = ultimo.answer;
    out["mode"] = "online";
    String r;
    serializeJson(out, r);
    result = r;

    Serial.print("IA online: RESPUESTA OK · ");
    Serial.print(ultimoGroqModelo);
    Serial.print(" · ");
    Serial.print(ultimoGroqDuracionMs);
    Serial.println(" ms");
  } else {
    ultimoChatFalloMs = millis();
    if (WiFi.status() != WL_CONNECTED) {
      groqFuncionando = false;
      estadoLed = LED_SIN_INTERNET;
    } else if (groqAuthError) {
      groqFuncionando = false;
      estadoLed = LED_INTERNET_SIN_GROQ;
    } else {
      if (groqFallosTransitorios < 255) groqFallosTransitorios++;
      if (groqAutorizado || ultimoGroqOkMs != 0) groqFuncionando = true;
      estadoLed = groqFuncionando ? LED_TODO_OK : LED_INTERNET_SIN_GROQ;
      if (groqFallosTransitorios >= 2) iaValidacionPendiente = true;
    }

    ATOM_JSON_DOC(out, 3072);
    String backup = respaldoLocalGeneral(messageOriginal);
    if (backup.length()) {
      out["answer"] = backup;
    } else if (ultimo.code == 429) {
      uint32_t waitSec = (ultimo.retryAfterMs + 999) / 1000;
      out["answer"] = waitSec
        ? ("Estoy disponible en modo local mientras el servicio externo descansa. Podrás volver a realizar esta pregunta en aproximadamente " + String(waitSec) + " segundos. ATOM-ArchBot y la interfaz continúan funcionando.")
        : "Estoy disponible en modo local mientras el servicio externo se recupera. ATOM-ArchBot y la interfaz continúan funcionando.";
    } else if (groqAuthError) {
      out["answer"] = "Estoy disponible en modo local. La configuración del servicio externo necesita revisión, pero ATOM-ArchBot, la telemetría y las respuestas esenciales del proyecto continúan funcionando.";
    } else {
      out["answer"] = "Estoy disponible en modo local mientras se recupera el servicio externo. Puedes preguntarme sobre ATOM-ArchBot, Los Harneritos, sus componentes, funcionamiento, detecciones y objetivos, o volver a intentar esta pregunta en unos momentos.";
    }
    out["mode"] = "local";
    out["notice"] = "external_recovery";
    String r;
    serializeJson(out, r);
    result = r;

    Serial.print("IA online: fallo final · HTTP ");
    Serial.print(ultimo.code);
    Serial.print(" · ");
    Serial.println(ultimo.error);
  }

  if (iaMutex && xSemaphoreTake(iaMutex, pdMS_TO_TICKS(500)) == pdTRUE) {
    if (iaJobId == jobActual) {
      iaJobResult = result;
      iaJobReady = true;
      iaJobReadyMs = millis();
      iaJobRunning = false;
      iaJobStartedMs = 0;
    }
    xSemaphoreGive(iaMutex);
  } else {
    iaJobRunning = false;
    iaJobStartedMs = 0;
  }
}


void iaWorkerTask(void* parameter) {
  for (;;) {
    ulTaskNotifyTake(pdTRUE, portMAX_DELAY);

    if (iaJobRunning) {
      procesarTrabajoIA();
    }

    if (iaValidacionPendiente && !iaJobRunning) {
      iaValidacionPendiente = false;
      iaValidacionNotificada = false;
      validarGroqAPI();
    }
  }
}


void verificarGroqEnSegundoPlano() {
  if (WiFi.status() != WL_CONNECTED || groqKey.length() <= 10) return;
  if (iaValidacionActiva) return;

  iaValidacionPendiente = true;
  if (iaWorkerHandle && !iaValidacionNotificada) {
    iaValidacionNotificada = true;
    xTaskNotifyGive(iaWorkerHandle);
  }
}


void handleChat(){
  enviarNoCache();
  if(!server.hasArg("plain")){server.send(400,"application/json","{\"error\":\"Falta la pregunta\"}");return;}
  String raw=server.arg("plain");
  if(raw.length()>8500){server.send(413,"application/json","{\"error\":\"Conversación demasiado larga para la ESP32. Reinicia la sesión con Alt Gr.\"}");return;}
  ATOM_JSON_DOC(input, 12288);if(deserializeJson(input,raw)){server.send(400,"application/json","{\"error\":\"JSON invalido\"}");return;}
  String message=input["message"]|"";message.trim();if(!message.length()||message.length()>MAX_CHAT_LENGTH){server.send(400,"application/json","{\"error\":\"Pregunta invalida\"}");return;}
  String visitorName=input["name"]|""; if(visitorName.length()>32) visitorName=visitorName.substring(0,32);
  String requestId=input["request_id"]|""; if(requestId.length()>48) requestId=requestId.substring(0,48);
  JsonArray history=input["history"].as<JsonArray>();

  bool mismoRequest =
    requestId.length() &&
    requestId==ultimoChatRequestId &&
    millis()-ultimoChatRequestMs<IA_RESULT_TTL_MS;

  if(mismoRequest && ultimoChatRequestJob!=0){
    ATOM_JSON_DOC(repetido, 256);
    repetido["queued"]=true;
    repetido["job"]=ultimoChatRequestJob;
    repetido["duplicate"]=true;
    String rr; serializeJson(repetido,rr);
    server.send(202,"application/json; charset=utf-8",rr);
    return;
  }

  if(!mismoRequest && millis()-ultimoChat<CHAT_COOLDOWN_MS){server.send(429,"application/json","{\"error\":\"Espera un momento antes de volver a preguntar.\"}");return;}
  ultimoChat=millis();

  if(!mismoRequest && requestId.length()){
    ultimoChatRequestId=requestId;
    ultimoChatRequestJob=0;
    ultimoChatRequestMs=millis();
  }

  if(consultaProyectoLocalPrioritaria(message)){
    offlineFallback(message);
    return;
  }

  if(WiFi.status()!=WL_CONNECTED || groqKey.length()<=10){offlineFallback(message);return;}

  if(groqAuthError){
    server.send(503,"application/json","{\"error\":\"La API Key de la IA necesita revisión.\"}");
    return;
  }

  if(ESP.getFreeHeap() < 50000){
    Serial.println("IA online: memoria baja antes de TLS; usando respaldo local");
    offlineFallback(message);
    return;
  }

  if(iaJobRunning){
    server.send(409,"application/json","{\"error\":\"ATOM.ia todavía está terminando la respuesta anterior.\"}");
    return;
  }

  String payload = construirPayloadChat(message, history, visitorName);
  uint32_t newId = iaJobId + 1;
  if(newId == 0) newId = 1;

  if(iaMutex && xSemaphoreTake(iaMutex, pdMS_TO_TICKS(300)) == pdTRUE){
    iaJobId = newId;
    iaJobPayload = payload;
    iaJobMessage = message;
    iaJobResult = "";
    iaJobReady = false;
    iaJobReadyMs = 0;
    iaJobRunning = true;
    iaJobStartedMs = millis();
    ultimoChatRequestId = requestId;
    ultimoChatRequestJob = newId;
    ultimoChatRequestMs = millis();
    xSemaphoreGive(iaMutex);
  } else {
    server.send(503,"application/json","{\"error\":\"No pude iniciar la consulta. Intenta nuevamente.\"}");
    return;
  }

  if (!iaWorkerHandle) {
    if(xSemaphoreTake(iaMutex, pdMS_TO_TICKS(100)) == pdTRUE){
      iaJobRunning=false;
      iaJobStartedMs=0;
      ultimoChatRequestId="";
      ultimoChatRequestJob=0;
      ultimoChatRequestMs=0;
      xSemaphoreGive(iaMutex);
    }
    server.send(503,"application/json","{\"error\":\"El worker de IA no está disponible.\"}");
    return;
  }

  xTaskNotifyGive(iaWorkerHandle);

  ATOM_JSON_DOC(out, 256);
  out["queued"] = true;
  out["job"] = newId;
  String r; serializeJson(out,r);
  server.send(202,"application/json; charset=utf-8",r);
}


void handleChatResult(){
  enviarNoCache();
  uint32_t requested = server.hasArg("id") ? server.arg("id").toInt() : 0;
  bool running=false, ready=false;
  uint32_t current=0;
  String result;
  if(iaMutex && xSemaphoreTake(iaMutex, pdMS_TO_TICKS(80)) == pdTRUE){
    running=iaJobRunning; ready=iaJobReady; current=iaJobId; if(ready) result=iaJobResult;
    xSemaphoreGive(iaMutex);
  }
  if(!requested || requested!=current){server.send(404,"application/json","{\"ready\":false,\"error\":\"Consulta no encontrada\"}");return;}
  if(!ready){
    ATOM_JSON_DOC(out, 256); out["ready"]=false; out["running"]=running; String r; serializeJson(out,r); server.send(202,"application/json",r); return;
  }
  server.send(200,"application/json; charset=utf-8",result);
}

void serveMainPage(){
  enviarNoCache();
  server.send_P(200,"text/html; charset=utf-8",ATOM_IA_INDEX_HTML);
}
String ipPreferidaParaCliente() {
  IPAddress remoto = server.client().remoteIP();
  if (remoto[0] == 192 && remoto[1] == 168 && remoto[2] == 4) {
    return WiFi.softAPIP().toString();
  }
  if (WiFi.status() == WL_CONNECTED) return WiFi.localIP().toString();
  return WiFi.softAPIP().toString();
}

void enviarNoCache() {
  server.sendHeader("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
  server.sendHeader("Pragma", "no-cache");
  server.sendHeader("Connection", "close");
}

void handleStatus(){
  ATOM_JSON_DOC(s, 4096);
  bool wifi=WiFi.status()==WL_CONNECTED;
  bool ai=iaOnlineReciente();
  bool robot=archbotOnline();

  String aiState;
  if (!wifi) aiState = "NO_INTERNET";
  else if (groqAuthError) aiState = "AUTH_ERROR";
  else if (iaJobRunning) aiState = "BUSY";
  else if (groqRateLimitUntilMs > millis()) aiState = "RATE_LIMIT";
  else if (ultimoChatFalloMs != 0 && millis() - ultimoChatFalloMs < IA_RECOVERY_STATE_MS) aiState = "LOCAL_RECOVERY";
  else if (ai) aiState = "READY";
  else aiState = "CHECKING";

  s["online"]=wifi;
  s["ai"]=ai;
  s["ai_state"]=aiState;
  s["groq_configured"]=groqKey.length()>10;
  s["groq_working"]=ai;
  s["ip_local"]=WiFi.softAPIP().toString();
  s["ip_wifi"]=wifi?WiFi.localIP().toString():"";
  s["preferred_ip"]=ipPreferidaParaCliente();
  s["direct_access"]=(ipPreferidaParaCliente()==WiFi.softAPIP().toString());
  s["mdns"]=mdnsActivo;
  s["url_mdns"]=mdnsActivo?"http://atom-ia.local":"";
  s["uptime_s"]=millis()/1000UL;
  s["boot_id"]=bootId;
  s["build"]="DIRECTO_V3";
  s["free_heap"]=ESP.getFreeHeap();
  s["min_free_heap"]=ESP.getMinFreeHeap();
  s["wifi_rssi"]=wifi?WiFi.RSSI():0;
  s["wifi_channel"]=wifi?WiFi.channel():0;
  s["wifi_retries"]=reintentosWiFiConsecutivos;
  s["internet_recovering"]=!wifi;
  s["ap_clients"]=WiFi.softAPgetStationNum();
  s["groq_http"]=ultimoGroqHttp;
  s["groq_error"]=ultimoGroqError;
  s["groq_last_ok_ms"]=ultimoGroqOkMs;
  s["groq_last_failure_ms"]=ultimoChatFalloMs;
  s["groq_job_running"]=iaJobRunning;
  s["groq_job_age_ms"]=(iaJobRunning && iaJobStartedMs)?(millis()-iaJobStartedMs):0;
  s["groq_model"]=ultimoGroqModelo;
  s["groq_duration_ms"]=ultimoGroqDuracionMs;
  s["groq_retry_after"]=ultimoGroqRetryAfter;
  s["groq_remaining_tokens"]=ultimoGroqRemainingTokens;
  s["groq_reset_tokens"]=ultimoGroqResetTokens;
  s["groq_request_id"]=ultimoGroqRequestId;
  s["groq_finish_reason"]=ultimoGroqFinishReason;
  s["groq_completion_tokens"]=ultimoGroqCompletionTokens;
  s["groq_reasoning_tokens"]=ultimoGroqReasoningTokens;
  s["groq_dns_ip"]=groqIpValida?groqIpCache.toString():"";
  s["catalog_version"]=5;
  s["archbot"]=robot;

  JsonObject a=s["archbot_data"].to<JsonObject>();
  a["connected"]=robot;
  a["ever_seen"]=archbotSeen;
  a["ap_active"]=(WiFi.softAPIP()[0] != 0);
  a["ap_clients"]=WiFi.softAPgetStationNum();
  a["state"]=robot?archbotState:(archbotSeen?"DESCONECTADO":"ESPERANDO");
  a["ip"]=archbotIp;
  a["object_id"]=archbotObjectId;
  a["object"]=archbotObject;
  a["confidence"]=archbotConfidence;
  a["event"]=archbotLastEvent;
  a["last_seen_ms"]=archbotSeen ? (millis()-archbotLastSeen) : 0;

  String r;
  r.reserve(1700);
  serializeJson(s,r);
  enviarNoCache();
  server.send(200,"application/json; charset=utf-8",r);
}



void handlePing(){
  enviarNoCache();
  server.send(200,"application/json","{\"ok\":true,\"server\":\"ATOM.ia\"}");
}

void handleDiagnostics(){
  ATOM_JSON_DOC(d, 4096);
  bool wifi = WiFi.status() == WL_CONNECTED;
  bool aiRecovering = ultimoChatFalloMs != 0 && millis() - ultimoChatFalloMs < IA_RECOVERY_STATE_MS;

  d["build"] = "DIRECTO_V3";
  d["boot_id"] = bootId;
  d["uptime_s"] = millis()/1000UL;

  JsonObject w = d["wifi"].to<JsonObject>();
  w["connected"] = wifi;
  w["ssid"] = wifi ? WiFi.SSID() : "";
  w["ip"] = wifi ? WiFi.localIP().toString() : "";
  w["gateway"] = wifi ? WiFi.gatewayIP().toString() : "";
  w["dns"] = wifi ? WiFi.dnsIP().toString() : "";
  w["rssi"] = wifi ? WiFi.RSSI() : 0;
  w["channel"] = wifi ? WiFi.channel() : 0;
  w["retries"] = reintentosWiFiConsecutivos;
  w["auto_reconnect"] = WiFi.getAutoReconnect();

  JsonObject ap = d["matrix_ap"].to<JsonObject>();
  ap["active"] = (WiFi.softAPIP()[0] != 0);
  ap["ip"] = WiFi.softAPIP().toString();
  ap["clients"] = WiFi.softAPgetStationNum();

  JsonObject ai = d["ai"].to<JsonObject>();
  ai["configured"] = groqKey.length() > 10;
  ai["authorized"] = groqAutorizado;
  ai["auth_error"] = groqAuthError;
  ai["ready"] = iaOnlineReciente() && !aiRecovering;
  ai["state"] = !wifi ? "NO_INTERNET" : (groqAuthError ? "AUTH_ERROR" : (iaJobRunning ? "BUSY" : (aiRecovering ? "LOCAL_RECOVERY" : (iaOnlineReciente() ? "READY" : "CHECKING"))));
  ai["validation_active"] = iaValidacionActiva;
  ai["job_running"] = iaJobRunning;
  ai["job_age_ms"] = (iaJobRunning && iaJobStartedMs) ? (millis()-iaJobStartedMs) : 0;
  ai["last_http"] = ultimoGroqHttp;
  ai["last_error"] = ultimoGroqError;
  ai["last_model"] = ultimoGroqModelo;
  ai["last_duration_ms"] = ultimoGroqDuracionMs;
  ai["retry_after"] = ultimoGroqRetryAfter;
  ai["remaining_tokens"] = ultimoGroqRemainingTokens;
  ai["reset_tokens"] = ultimoGroqResetTokens;
  ai["request_id"] = ultimoGroqRequestId;
  ai["finish_reason"] = ultimoGroqFinishReason;
  ai["completion_tokens"] = ultimoGroqCompletionTokens;
  ai["reasoning_tokens"] = ultimoGroqReasoningTokens;
  ai["last_ok_ms"] = ultimoGroqOkMs;
  ai["transient_failures"] = groqFallosTransitorios;
  ai["dns_ip"] = groqIpValida ? groqIpCache.toString() : "";

  JsonObject mem = d["memory"].to<JsonObject>();
  mem["free_heap"] = ESP.getFreeHeap();
  mem["min_free_heap"] = ESP.getMinFreeHeap();

  JsonObject bot = d["archbot"].to<JsonObject>();
  bot["connected"] = archbotOnline();
  bot["ever_seen"] = archbotSeen;
  bot["ap_clients"] = WiFi.softAPgetStationNum();
  bot["ip"] = archbotIp;
  bot["last_event"] = archbotLastEvent;
  bot["last_seen_ms"] = archbotSeen ? (millis()-archbotLastSeen) : 0;

  d["mdns"] = mdnsActivo;

  String r;
  r.reserve(2200);
  serializeJson(d,r);
  enviarNoCache();
  server.send(200,"application/json; charset=utf-8",r);
}



bool iniciarMDNS(bool mostrarEstado = true) {
  ultimoIntentoMDNS = millis();

  if (WiFi.status() != WL_CONNECTED) {
    mdnsActivo = false;
    return false;
  }

  MDNS.end();
  mdnsActivo = false;
  delay(30);

  mdnsActivo = MDNS.begin("atom-ia");

  if (mdnsActivo) {
    MDNS.addService("http", "tcp", 80);
    MDNS.addServiceTxt("http", "tcp", "nombre", "ATOM.ia");
    MDNS.addServiceTxt("http", "tcp", "proyecto", "ATOM-ArchBot");
  }

  if (mostrarEstado) {
    Serial.print("mDNS: ");
    Serial.println(mdnsActivo ? "ACTIVO · http://atom-ia.local" : "ERROR");
    if (!mdnsActivo) {
      Serial.print("Usar IP directa: http://");
      Serial.println(WiFi.localIP());
    }
  }

  return mdnsActivo;
}

void detenerMDNS() {
  if (mdnsActivo) {
    MDNS.end();
    mdnsActivo = false;
    Serial.println("mDNS: detenido hasta recuperar WiFi");
  }
}

void mantenerMDNS() {
  if (WiFi.status() != WL_CONNECTED) return;
  if (mdnsActivo) return;
  if (millis() - ultimoIntentoMDNS < MDNS_RETRY_MS) return;

  Serial.println("mDNS: reintentando publicar atom-ia.local");
  iniciarMDNS(true);
}

bool configurarAPCompatible() {
  wifi_config_t config;
  memset(&config, 0, sizeof(config));

  esp_err_t lectura = esp_wifi_get_config(WIFI_IF_AP, &config);
  if (lectura != ESP_OK) {
    Serial.printf("AP directo: no se pudo leer configuracion (%d)\n", (int)lectura);
    return false;
  }

  config.ap.authmode = WIFI_AUTH_WPA2_PSK;
  config.ap.pmf_cfg.capable = false;
  config.ap.pmf_cfg.required = false;
  config.ap.max_connection = AP_MAX_CLIENTS;

  esp_err_t escritura = esp_wifi_set_config(WIFI_IF_AP, &config);
  if (escritura != ESP_OK) {
    Serial.printf("AP directo: no se pudo aplicar compatibilidad (%d)\n", (int)escritura);
    return false;
  }

  Serial.println("AP directo: WPA2 compatible / PMF no requerido");
  return true;
}

void imprimirClientesAP() {
  wifi_sta_list_t lista;
  memset(&lista, 0, sizeof(lista));
  if (esp_wifi_ap_get_sta_list(&lista) != ESP_OK) return;

  for (int i = 0; i < lista.num; i++) {
    const uint8_t* m = lista.sta[i].mac;
    Serial.printf(
      "  cliente %d MAC %02X:%02X:%02X:%02X:%02X:%02X\n",
      i + 1, m[0], m[1], m[2], m[3], m[4], m[5]
    );
  }
}

void iniciarRedATOM(){
  IPAddress ip(192,168,4,1), gw(192,168,4,1), sub(255,255,255,0);

  WiFi.mode(WIFI_AP_STA);
  WiFi.softAPConfig(ip,gw,sub);

  uint8_t canal = 1;
  if (WiFi.status() == WL_CONNECTED) {
    uint8_t canalSta = WiFi.channel();
    if (canalSta >= 1 && canalSta <= 13) canal = canalSta;
  }

  apActivo = WiFi.softAP(ATOM_AP_SSID, ATOM_AP_PASS, canal, 0, AP_MAX_CLIENTS);

  if (apActivo) configurarAPCompatible();

  Serial.println(apActivo ? "Red privada MATRIX ATOM-ARCHBOT: ACTIVA" : "Red privada MATRIX ATOM-ARCHBOT: ERROR");
  Serial.print("Canal AP MATRIX: ");
  Serial.println(canal);
  Serial.print("IP DIRECTA PC + MATRIX: http://");
  Serial.println(WiFi.softAPIP());
}


void conectarInternet(){
  estadoLed = LED_ARRANCANDO;
  Serial.print("Internet: conectando a ");
  Serial.println(WIFI_SSID);

  WiFi.begin(WIFI_SSID, WIFI_PASS);
  intentoWifiActivo = true;
  wifiEstabaConectado = false;
  groqFuncionando = false;
  ultimoIntentoWiFi = millis();
  momentoPerdidaInternet = millis();
  Serial.println("Internet: conexión iniciada en segundo plano");
}

void mantenerInternet(){
  bool conectado = (WiFi.status() == WL_CONNECTED);
  uint32_t ahora = millis();

  if (conectado) {
    ultimoWifiOkMs = ahora;

    if (!wifiEstabaConectado) {
      wifiEstabaConectado = true;
      intentoWifiActivo = false;
      pedirReconexionInternet = false;
      pedirRefrescoRuta = false;
      reintentosWiFiConsecutivos = 0;
      momentoPerdidaInternet = 0;
      estadoLed = iaOnlineReciente() ? LED_TODO_OK : LED_INTERNET_SIN_GROQ;

      WiFi.setAutoReconnect(true);
      WiFi.setSleep(false);

      Serial.println();
      Serial.println("Internet/WiFi: RECUPERADO");
      Serial.print("IP STA: "); Serial.println(WiFi.localIP());
      Serial.print("RSSI: "); Serial.println(WiFi.RSSI());

      iniciarMDNS(false);
      groqIpValida = false;

      ultimoIntentoValidacionIA = 0;
      iaValidacionPendiente = true;
    }

    if (pedirRefrescoRuta && !iaJobRunning && ahora - ultimoIntentoWiFiDuro >= WIFI_RECONNECT_HARD_MS) {
      pedirRefrescoRuta = false;
      ultimoIntentoWiFiDuro = ahora;
      Serial.println("Internet/WiFi: refrescando STA por fallo de ruta");
      WiFi.reconnect();
    }
    return;
  }

  if (wifiEstabaConectado) {
    wifiEstabaConectado = false;
    groqFuncionando = false;
    estadoLed = LED_SIN_INTERNET;
    momentoPerdidaInternet = ahora;
    groqIpValida = false;
    detenerMDNS();
    Serial.println();
    Serial.println("Internet/WiFi: SE PERDIO");
    Serial.println("ATOM-ARCHBOT permanece activo para MATRIX.");
  }

  if (momentoPerdidaInternet == 0) momentoPerdidaInternet = ahora;
  if (!pedirReconexionInternet && ahora - ultimoIntentoWiFi < WIFI_RECONNECT_FAST_MS) return;

  ultimoIntentoWiFi = ahora;
  pedirReconexionInternet = false;
  if (reintentosWiFiConsecutivos < 255) reintentosWiFiConsecutivos++;

  WiFi.setAutoReconnect(true);
  WiFi.setSleep(false);
  Serial.print("Internet/WiFi: reconnect #"); Serial.println(reintentosWiFiConsecutivos);
  WiFi.reconnect();

  if (
    ahora - momentoPerdidaInternet >= WIFI_BEGIN_FALLBACK_MS &&
    ahora - ultimoIntentoWiFiDuro >= WIFI_BEGIN_FALLBACK_MS
  ) {
    ultimoIntentoWiFiDuro = ahora;
    Serial.println("Internet/WiFi: último recurso STA begin()");
    WiFi.begin(WIFI_SSID, WIFI_PASS);
  }
}


void mantenerGroq(){
  if (WiFi.status() != WL_CONNECTED) {
    groqFuncionando = false;
    estadoLed = LED_SIN_INTERNET;
    return;
  }

  uint32_t ahora = millis();

  bool necesitaValidar = !groqAutorizado && !groqAuthError;
  bool tiempoValidar = ultimoIntentoValidacionIA == 0 ||
    (ahora - ultimoIntentoValidacionIA >= GROQ_VALIDATE_RETRY_MS);

  if (
    (iaValidacionPendiente || (necesitaValidar && tiempoValidar)) &&
    !iaJobRunning &&
    !iaValidacionActiva &&
    iaWorkerHandle
  ) {
    iaValidacionPendiente = true;
    if (!iaValidacionNotificada) {
      iaValidacionNotificada = true;
      xTaskNotifyGive(iaWorkerHandle);
    }
  }

  if (iaOnlineReciente()) estadoLed = LED_TODO_OK;
  else if (!groqAuthError) estadoLed = LED_INTERNET_SIN_GROQ;
}


void monitorearAPMatrix(){
  if (millis() - ultimoMonitorAPMs < 2000) return;
  ultimoMonitorAPMs = millis();

  uint8_t clientes = WiFi.softAPgetStationNum();

  if (clientes != ultimoNumeroClientesAP) {
    ultimoNumeroClientesAP = clientes;

    Serial.print("ATOM-ARCHBOT · clientes directos: ");
    Serial.println(clientes);

    if (clientes == 0) {
      Serial.println("AP directo: esperando PC y MATRIX en ATOM-ARCHBOT");
    } else {
      Serial.println("AP directo: PC y/o MATRIX conectado");
      imprimirClientesAP();
    }
  }
}

void mantenerSalud(){
  if (millis() - ultimoChequeoSalud < 5000) return;
  ultimoChequeoSalud = millis();

  IPAddress apip = WiFi.softAPIP();
  if (apip[0] == 0 || apip[1] == 0) {
    Serial.println("SALUD: AP MATRIX perdido · restaurando ATOM-ARCHBOT");
    iniciarRedATOM();
  }

  uint32_t heap = ESP.getFreeHeap();

  if (heap < 45000) {
    Serial.print("SALUD: memoria libre baja: ");
    Serial.println(heap);
  }

  if (
    iaJobReady &&
    !iaJobRunning &&
    iaJobReadyMs != 0 &&
    millis() - iaJobReadyMs > IA_RESULT_TTL_MS
  ) {
    if (iaMutex && xSemaphoreTake(iaMutex, pdMS_TO_TICKS(60)) == pdTRUE) {
      iaJobPayload = "";
      iaJobMessage = "";
      iaJobResult = "";
      iaJobReady = false;
      iaJobReadyMs = 0;
      xSemaphoreGive(iaMutex);
    }
  }
}

void iniciarServidor(){
  server.enableCORS(true);
  const char* headers[]={"X-ATOM-Key"};server.collectHeaders(headers,1);
  server.on("/",HTTP_GET,serveMainPage);server.on("/index.html",HTTP_GET,serveMainPage);server.on("/api/ping",HTTP_GET,handlePing);server.on("/api/status",HTTP_GET,handleStatus);server.on("/api/diagnostics",HTTP_GET,handleDiagnostics);server.on("/api/chat",HTTP_POST,handleChat);server.on("/api/chat/result",HTTP_GET,handleChatResult);server.on("/api/archbot/heartbeat",HTTP_POST,handleArchbotHeartbeat);server.on("/api/archbot/event",HTTP_POST,handleArchbotEvent);server.on("/api/archbot/status",HTTP_GET,handleArchbotStatus);server.onNotFound([](){server.send(404,"text/plain","No encontrado");});server.begin();
  discoveryUdp.begin(DISCOVERY_PORT);
  iniciarMDNS(false);
  Serial.println("============================");
  Serial.println("ATOM.IA · SISTEMA LISTO");
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("WiFi de Internet para ESP32/Groq: ");
    Serial.println(WIFI_SSID);
    Serial.print("IP STA de respaldo: http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("WiFi principal: RECUPERANDO CONEXION");
    Serial.println("La red directa PC + MATRIX sigue activa.");
  }
  Serial.println("PC: conectarse a ATOM-ARCHBOT");
  Serial.print("URL PRINCIPAL PC + MATRIX: http://");
  Serial.println(WiFi.softAPIP());
  Serial.print("Internet: ");
  Serial.println(WiFi.status()==WL_CONNECTED?"FUNCIONANDO":"RECUPERANDO");
  Serial.print("IA online: ");
  Serial.println(iaOnlineReciente()?"DISPONIBLE":"VERIFICANDO / ESPERANDO");
  Serial.println("Esperando MATRIX Mini R4...");
  Serial.println("============================");
}

void setup(){
  pinMode(LED_PIN,OUTPUT);
  ledFisico(true);
  estadoLed=LED_ARRANCANDO;
  Serial.begin(115200);
  delay(350);
  Serial.println();
  Serial.println("BOOT 1/5 · CPU, LED y puerto serie activos");

  iaMutex=xSemaphoreCreateMutex();

  if(!iaMutex){
    Serial.println("ADVERTENCIA: no se pudo crear mutex de IA");
  } else {
    Serial.println("BOOT 2/5 · memoria de IA preparada");
  }

  Serial.println("ATOM.IA · DIRECTO V3 · PC + MATRIX EN 192.168.4.1");
  bootId = (uint32_t)(ESP.getEfuseMac() ^ micros());
  cargarGroqKey();

  WiFi.mode(WIFI_AP_STA);
  WiFi.persistent(false);
  WiFi.setAutoReconnect(true);
  WiFi.setSleep(false);
  WiFi.setHostname("atom-ia");

  iniciarRedATOM();
  Serial.println("BOOT 3/5 · red directa ATOM-ARCHBOT iniciada");

  iniciarServidor();
  Serial.println("BOOT 4/5 · servidor local iniciado");

  BaseType_t workerOk = xTaskCreate(
    iaWorkerTask,
    "atom_ia_worker",
    16384,
    nullptr,
    1,
    &iaWorkerHandle
  );

  if(workerOk != pdPASS){
    iaWorkerHandle = nullptr;
    Serial.println("ERROR: no se pudo crear worker persistente de IA");
  }

  conectarInternet();
  Serial.println("BOOT 5/5 · sistema local listo; Internet recuperándose");
}


void loop(){
  server.handleClient();
  handleDiscovery();
  mantenerInternet();
  mantenerMDNS();
  mantenerGroq();
  monitorearAPMatrix();
  mantenerSalud();
  actualizarLed();

  if(archbotSeen && !archbotOnline() && archbotState!="DESCONECTADO"){
    archbotState="DESCONECTADO";
    Serial.println("ATOM-ArchBot: OFFLINE (sin heartbeat)");
  }

  delay(1);
}
