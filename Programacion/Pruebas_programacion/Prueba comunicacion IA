// ============================================================

void conectarWiFi()
{
    pantallaConectando();

    rgbAzul();

    Serial.println();

    Serial.println(
        "============================"
    );

    Serial.println(
        "MATRIX -> ATOM.IA"
    );

    Serial.print(
        "Conectando a: "
    );

    Serial.println(
        WIFI_SSID
    );


    WiFi.begin(
        WIFI_SSID,
        WIFI_PASS
    );


    unsigned long inicio =
        millis();


    while (
        WiFi.status() != WL_CONNECTED
        &&
        millis() - inicio < 15000
    )
    {
        delay(250);
    }


    if (
        WiFi.status()
        ==
        WL_CONNECTED
    )
    {
        wifiConectadoAnterior = true;

        rgbVerde();

        Serial.println();

        Serial.println(
            "WIFI CONECTADO"
        );

        Serial.print(
            "IP MATRIX: "
        );

        Serial.println(
            WiFi.localIP()
        );

        Serial.print(
            "ESP32: "
        );

        Serial.println(
            ESP32_IP
        );

        delay(600);
    }
    else
    {
        wifiConectadoAnterior = false;

        rgbNaranja();

        Serial.println();

        Serial.println(
            "NO SE PUDO CONECTAR"
        );

        Serial.println(
            "Reintentara automaticamente."
        );

        delay(600);
    }


    pantallaMenu();
}


// ============================================================
// MANTENER WIFI
// ============================================================

void mantenerWiFi()
{
    bool conectado =
        WiFi.status()
        ==
        WL_CONNECTED;


    if (
        conectado
        &&
        !wifiConectadoAnterior
    )
    {
        wifiConectadoAnterior = true;

        Serial.println();

        Serial.println(
            "WIFI RECONECTADO"
        );

        Serial.print(
            "IP MATRIX: "
        );

        Serial.println(
            WiFi.localIP()
        );

        rgbVerde();

        pantallaMenu();
    }


    if (
        !conectado
        &&
        wifiConectadoAnterior
    )
    {
        wifiConectadoAnterior = false;

        Serial.println();

        Serial.println(
            "WIFI DESCONECTADO"
        );

        rgbNaranja();

        pantallaMenu();
    }


    if (
        !conectado
        &&
        millis() - ultimoIntentoWiFi
        >=
        INTERVALO_RECONEXION_WIFI
    )
    {
        ultimoIntentoWiFi =
            millis();

        Serial.println(
            "Reintentando WiFi..."
        );

        WiFi.begin(
            WIFI_SSID,
            WIFI_PASS
        );
    }
}


// ============================================================
// LEER RESPUESTA HTTP
// ============================================================

int leerCodigoHTTP(
    WiFiClient &c
)
{
    unsigned long inicio =
        millis();

    while (
        !c.available()
        &&
        millis() - inicio < 2500
    )
    {
        delay(1);
    }


    if (!c.available())
    {
        return -1;
    }


    String linea =
        c.readStringUntil('\n');

    linea.trim();


    // Ejemplo:
    // HTTP/1.1 200 OK

    if (
        !linea.startsWith(
            "HTTP/"
        )
    )
    {
        return -1;
    }


    int espacio1 =
        linea.indexOf(' ');

    if (espacio1 < 0)
    {
        return -1;
    }


    int espacio2 =
        linea.indexOf(
            ' ',
            espacio1 + 1
        );


    String codigoTexto;


    if (espacio2 > 0)
    {
        codigoTexto =
            linea.substring(
                espacio1 + 1,
                espacio2
            );
    }
    else
    {
        codigoTexto =
            linea.substring(
                espacio1 + 1
            );
    }


    return codigoTexto.toInt();
}


// ============================================================
// HEARTBEAT
// ============================================================

bool enviarHeartbeat()
{
    if (
        WiFi.status()
        !=
        WL_CONNECTED
    )
    {
        return false;
    }


    WiFiClient c;


    if (
        !c.connect(
            ESP32_IP,
            ESP32_PORT
        )
    )
    {
        return false;
    }


    String body = "{}";


    c.println(
        "POST /api/archbot/heartbeat HTTP/1.1"
    );

    c.print("Host: ");
    c.println(ESP32_IP);

    c.print("X-ATOM-Key: ");
    c.println(ARCHBOT_TOKEN);

    c.println(
        "Content-Type: application/json"
    );

    c.print(
        "Content-Length: "
    );

    c.println(
        body.length()
    );

    c.println(
        "Connection: close"
    );

    c.println();

    c.print(body);


    int codigo =
        leerCodigoHTTP(c);


    c.stop();


    return (
        codigo >= 200
        &&
        codigo < 300
    );
}


// ============================================================
// MANTENER HEARTBEAT
// ============================================================

void mantenerHeartbeat()
{
    if (
        millis()
        -
        ultimoHeartbeat
        <
        INTERVALO_HEARTBEAT
    )
    {
        return;
    }


    ultimoHeartbeat =
        millis();


    if (
        WiFi.status()
        !=
        WL_CONNECTED
    )
    {
        return;
    }


    bool ok =
        enviarHeartbeat();


    if (ok)
    {
        Serial.println(
            "Heartbeat -> ATOM.IA OK"
        );
    }
    else
    {
        Serial.println(
            "Heartbeat -> ERROR"
        );
    }
}


// ============================================================
// ENVIAR EVENTO
// ============================================================

bool enviarEvento(
    uint8_t objeto,
    uint8_t confianza,
    uint32_t evento
)
{
    if (
        WiFi.status()
        !=
        WL_CONNECTED
    )
    {
        Serial.println(
            "No se puede enviar: WiFi desconectado"
        );

        return false;
    }


    WiFiClient c;


    Serial.println();

    Serial.println(
        "Conectando con ESP32..."
    );


    if (
        !c.connect(
            ESP32_IP,
            ESP32_PORT
        )
    )
    {
        Serial.println(
            "ERROR conectando con 192.168.4.1"
        );

        return false;
    }


    // --------------------------------------------------------
    // JSON
    // --------------------------------------------------------

    String body = "{";

    body += "\"estado\":1,";

    body += "\"objeto_id\":";
    body += String(objeto);
    body += ",";

    body += "\"confianza\":";
    body += String(confianza);
    body += ",";

    body += "\"evento\":";
    body += String(evento);

    body += "}";


    Serial.println();

    Serial.println(
        "ENVIANDO A ATOM.IA:"
    );

    Serial.println(body);


    // --------------------------------------------------------
    // HTTP
    // --------------------------------------------------------

    c.println(
        "POST /api/archbot/event HTTP/1.1"
    );

    c.print("Host: ");
    c.println(ESP32_IP);

    c.print("X-ATOM-Key: ");
    c.println(ARCHBOT_TOKEN);

    c.println(
        "Content-Type: application/json"
    );

    c.print(
        "Content-Length: "
    );

    c.println(
        body.length()
    );

    c.println(
        "Connection: close"
    );

    c.println();

    c.print(body);


    int codigo =
        leerCodigoHTTP(c);


    Serial.print(
        "HTTP: "
    );

    Serial.println(
        codigo
    );


    // Vaciar respuesta restante

    unsigned long limite =
        millis();

    while (
        millis() - limite < 300
    )
    {
        while (c.available())
        {
            c.read();
        }

        if (!c.connected())
        {
            break;
        }
    }


    c.stop();


    return (
        codigo >= 200
        &&
        codigo < 300
    );
}


// ============================================================
// CAMBIAR OBJETO
// BOTON DERECHO ARRIBA
// ============================================================

void cambiarObjeto()
{
    if (
        objetoSeleccionado
        ==
        OBJETO_SELLO
    )
    {
        objetoSeleccionado =
            OBJETO_PUNTA;
    }
    else
    {
        objetoSeleccionado =
            OBJETO_SELLO;
    }


    Serial.print(
        "Seleccionado: "
    );

    Serial.println(
        nombreObjeto(
            objetoSeleccionado
        )
    );


    MiniR4.Buzzer.Tone(
        NOTE_C5,
        50
    );

    delay(60);

    MiniR4.Buzzer.NoTone();


    pantallaMenu();
}


// ============================================================
// ENVIAR OBJETO SELECCIONADO
// BOTON DERECHO ABAJO
// ============================================================

void enviarSeleccionado()
{
    contadorEventos++;


    if (
        contadorEventos == 0
    )
    {
        contadorEventos = 1;
    }


    pantallaEnviando();

    rgbAzul();


    Serial.println();

    Serial.println(
        "============================"
    );

    Serial.println(
        "HALLAZGO SIMULADO"
    );

    Serial.print(
        "Objeto: "
    );

    Serial.println(
        nombreObjeto(
            objetoSeleccionado
        )
    );

    Serial.print(
        "Confianza: "
    );

    Serial.print(
        confianzaSimulada
    );

    Serial.println("%");

    Serial.print(
        "Evento: "
    );

    Serial.println(
        contadorEventos
    );

    Serial.println(
        "============================"
    );


    bool enviado =
        enviarEvento(
            objetoSeleccionado,
            confianzaSimulada,
            contadorEventos
        );


    if (enviado)
    {
        estadoEnvio =
            "OK";

        tiempoEstadoEnvio =
            millis();

        rgbVerde();

        pantallaEnviado();

        sonidoEnvioCorrecto();

        Serial.println(
            "EVENTO RECIBIDO POR ATOM.IA"
        );
    }
    else
    {
        estadoEnvio =
            "ERROR";

        tiempoEstadoEnvio =
            millis();

        rgbRojo();

        pantallaError();

        sonidoError();

        Serial.println(
            "ERROR ENVIANDO EVENTO"
        );
    }
}


// ============================================================
// BOTONES
// ============================================================

void actualizarBotones()
{
    // --------------------------------------------------------
    // BOTON DERECHO ARRIBA
    // --------------------------------------------------------

    bool arriba =
        MiniR4.BTN_UP.getState();


    if (
        arriba
        &&
        !botonArribaAnterior
        &&
        millis() - ultimoBotonArriba
        >=
        DEBOUNCE_BOTON
    )
    {
        ultimoBotonArriba =
            millis();

        cambiarObjeto();
    }


    botonArribaAnterior =
        arriba;


    // --------------------------------------------------------
    // BOTON DERECHO ABAJO
    // --------------------------------------------------------

    bool abajo =
        MiniR4.BTN_DOWN.getState();


    if (
        abajo
        &&
        !botonAbajoAnterior
        &&
        millis() - ultimoBotonAbajo
        >=
        DEBOUNCE_BOTON
    )
    {
        ultimoBotonAbajo =
            millis();

        enviarSeleccionado();
    }


    botonAbajoAnterior =
        abajo;
}


// ============================================================
// RESTAURAR MENU DESPUES DEL ENVIO
// ============================================================

void actualizarEstadoPantalla()
{
    if (
        estadoEnvio == "LISTO"
    )
    {
        return;
    }


    if (
        millis()
        -
        tiempoEstadoEnvio
        <
        TIEMPO_MENSAJE
    )
    {
        return;
    }


    estadoEnvio =
        "LISTO";


    if (
        WiFi.status()
        ==
        WL_CONNECTED
    )
    {
        rgbVerde();
    }
    else
    {
        rgbNaranja();
    }


    pantallaMenu();
}


