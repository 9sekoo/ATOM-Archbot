    Serial.println("============================");
    Serial.println();
}


void procesarNuevoHallazgo()
{
    if (!objetoDetectado)
    {
        return;
    }

    if (eventoActual == 0)
    {
        return;
    }

    if (eventoActual == ultimoEventoProcesado)
    {
        return;
    }

    ultimoEventoProcesado =
        eventoActual;

    rgbVerde();

    pantallaHallazgo();

    imprimirHallazgo();

    sonidoNuevoHallazgo();
}


void leerMVision()
{
    int cantidad =
        MiniR4.Vision.SmartCamReader(
            datosCamara,
            10
        );


    if (cantidad < 4)
    {
        return;
    }


    unsigned int nuevoEstado =
        datosCamara[0];

    unsigned int nuevoObjeto =
        datosCamara[1];

    unsigned int nuevaConfianza =
        datosCamara[2];

    unsigned int nuevoEvento =
        datosCamara[3];


    objetoDetectado =
        (nuevoEstado == 1);

    objetoActual =
        nuevoObjeto;

    confianzaActual =
        nuevaConfianza;

    eventoActual =
        nuevoEvento;


    Serial.print("MV | ");

    Serial.print(nombreObjeto(objetoActual));

    Serial.print(" | ");

    Serial.print(confianzaActual);

    Serial.print("% | Estado:");

    Serial.print(nuevoEstado);

    Serial.print(" | Evento:");

    Serial.println(eventoActual);


    procesarNuevoHallazgo();
}


void actualizarBoton()
{
    bool botonActual =
        MiniR4.BTN_UP.getState();


    if (
        botonActual
        &&
        !botonAnterior
        &&
        millis() - ultimoCambioBoton
        >=
        DEBOUNCE_BOTON
    )
    {
        ultimoCambioBoton =
            millis();


        if (!sistemaIniciado)
        {
            sistemaIniciado = true;
            sistemaPausado = false;

            objetoDetectado = false;

            objetoActual = 0;
            confianzaActual = 0;
            eventoActual = 0;

            rgbRojo();

            pantallaBuscando();

            ultimoPi = millis();

            Serial.println();
            Serial.println("ATOM ARCHBOT INICIADO");
        }
        else
        {
            sistemaPausado =
                !sistemaPausado;

            MiniR4.Buzzer.NoTone();


            if (sistemaPausado)
            {
                rgbNaranja();

                pantallaPausa();

                Serial.println(
                    "ATOM PAUSADO"
                );
            }
            else
            {
                rgbRojo();

                pantallaBuscando();

                ultimoPi = millis();

                Serial.println(
                    "ATOM REANUDADO"
                );
            }
        }
    }


    botonAnterior =
        botonActual;
}


void setup()
{
    MiniR4.begin();

    Serial.begin(115200);

    MiniR4.Vision.Begin();


    MiniR4.LED.setBrightness(1, 80);
    MiniR4.LED.setBrightness(2, 80);


    rgbApagado();


    conectarWiFi();


    sistemaIniciado = false;
    sistemaPausado = false;

    objetoDetectado = false;

    objetoActual = 0;
    confianzaActual = 0;
    eventoActual = 0;

    ultimoEventoProcesado = 0;


    pantallaInicio();


    Serial.println();
    Serial.println("ATOM ARCHBOT LISTO");

    Serial.println(
        "M-Vision: [estado,objeto,confianza,evento]"
    );

    if (WiFi.status() == WL_CONNECTED)
    {
        Serial.println(
            "WiFi: CONECTADO"
        );
    }
    else
    {
        Serial.println(
            "WiFi: SIN CONEXION"
        );
    }
}


void loop()
{
    mantenerWiFi();

    actualizarBoton();


    if (!sistemaIniciado)
    {
        MiniR4.Buzzer.NoTone();

        actualizarPantalla();

        delay(3);

        return;
    }


    if (sistemaPausado)
    {
        MiniR4.Buzzer.NoTone();

        actualizarPantalla();

        delay(3);

        return;
    }


    leerMVision();


    actualizarPantalla();


    if (!objetoDetectado)
    {
        rgbRojo();

        sonidoBuscando();
    }


    delay(2);
}
