void actualizarPantalla()
{
    if (millis() - ultimaPantalla < INTERVALO_PANTALLA)
    {
        return;
    }

    ultimaPantalla = millis();

    if (!sistemaIniciado)
    {
        pantallaInicio();
        return;
    }

    if (sistemaPausado)
    {
        pantallaPausa();
        return;
    }

    if (objetoDetectado)
    {
        pantallaHallazgo();
        return;
    }

    if (objetoActual != 0 && confianzaActual > 0)
    {
        pantallaDetectando();
        return;
    }

    pantallaBuscando();
}


void sonidoBuscando()
{
    if (millis() - ultimoPi >= INTERVALO_PI)
    {
        ultimoPi = millis();

        MiniR4.Buzzer.Tone(
            NOTE_C5,
            DURACION_PI
        );
    }
}


const int melodiaHallazgo[] =
{
    NOTE_G4,
    NOTE_C5,
    NOTE_E5,
    NOTE_G5
};


const int duracionHallazgo[] =
{
    80,
    100,
    100,
    250
};


const int TOTAL_NOTAS =
    sizeof(melodiaHallazgo)
    /
    sizeof(melodiaHallazgo[0]);


void sonidoNuevoHallazgo()
{
    for (int i = 0; i < TOTAL_NOTAS; i++)
    {
        MiniR4.Buzzer.Tone(
            melodiaHallazgo[i],
            duracionHallazgo[i]
        );

        delay(
            duracionHallazgo[i] + 30
        );
    }

    MiniR4.Buzzer.NoTone();
}


void conectarWiFi()
{
    pantallaConectandoWiFi();

    rgbAzul();

    Serial.println();
    Serial.print("Conectando a ");
    Serial.println(WIFI_SSID);

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASS
    );

    unsigned long inicio = millis();

    while (
        WiFi.status() != WL_CONNECTED
        &&
        millis() - inicio < 15000
    )
    {
        delay(250);
    }

    if (WiFi.status() == WL_CONNECTED)
    {
        wifiConectadoAnterior = true;

        rgbVerde();

        pantallaWiFiConectado();

        Serial.println();
        Serial.println("WiFi conectado correctamente");

        Serial.print("Red: ");
        Serial.println(WIFI_SSID);

        Serial.print("IP: ");
        Serial.println(WiFi.localIP());

        delay(1800);
    }
    else
    {
        wifiConectadoAnterior = false;

        rgbNaranja();

        pantallaWiFiError();

        Serial.println();
        Serial.println("No se pudo conectar al WiFi");

        Serial.println(
            "ATOM seguira funcionando y reintentara."
        );

        delay(1200);
    }
}


void mantenerWiFi()
{
    bool conectado =
        WiFi.status() == WL_CONNECTED;


    if (conectado && !wifiConectadoAnterior)
    {
        wifiConectadoAnterior = true;

        Serial.println();
        Serial.println("WiFi reconectado");

        Serial.print("IP: ");
        Serial.println(WiFi.localIP());

        if (!objetoDetectado && sistemaIniciado)
        {
            pantallaBuscando();
        }
    }


    if (!conectado && wifiConectadoAnterior)
    {
        wifiConectadoAnterior = false;

        Serial.println();
        Serial.println("WiFi desconectado");
    }


    if (
        !conectado
        &&
        millis() - ultimoIntentoWiFi
        >=
        INTERVALO_RECONEXION_WIFI
    )
    {
        ultimoIntentoWiFi = millis();

        Serial.println(
            "Intentando reconectar WiFi..."
        );

        WiFi.begin(
            WIFI_SSID,
            WIFI_PASS
        );
    }
}


