// I2C

void seleccionarCanal(byte canal) {

  Wire1.beginTransmission(MUX_ADDR);
  Wire1.write(1 << canal);
  Wire1.endTransmission();

  delayMicroseconds(200);
}

bool existeI2C(
  byte canal,
  uint8_t direccion
) {

  seleccionarCanal(canal);

  Wire1.beginTransmission(direccion);

  return Wire1.endTransmission() == 0;
}

uint8_t buscarLCD(byte canal) {

  if (existeI2C(canal, 0x27))
    return 0x27;

  if (existeI2C(canal, 0x3F))
    return 0x3F;

  for (uint8_t d = 0x20; d <= 0x27; d++) {

    if (existeI2C(canal, d))
      return d;
  }

  for (uint8_t d = 0x38; d <= 0x3F; d++) {

    if (d == 0x3D)
      continue;

    if (existeI2C(canal, d))
      return d;
  }

  return 0;
}


// LCD

void lcdExpanderWrite(
  byte canal,
  uint8_t direccion,
  uint8_t dato
) {

  seleccionarCanal(canal);

  Wire1.beginTransmission(direccion);
  Wire1.write(dato | LCD_BACKLIGHT);
  Wire1.endTransmission();
}

void lcdPulseEnable(
  byte canal,
  uint8_t direccion,
  uint8_t dato
) {

  lcdExpanderWrite(
    canal,
    direccion,
    dato | LCD_EN
  );

  delayMicroseconds(1);

  lcdExpanderWrite(
    canal,
    direccion,
    dato & ~LCD_EN
  );

  delayMicroseconds(50);
}

void lcdWrite4Bits(
  byte canal,
  uint8_t direccion,
  uint8_t dato
) {

  lcdExpanderWrite(
    canal,
    direccion,
    dato
  );

  lcdPulseEnable(
    canal,
    direccion,
    dato
  );
}

void lcdSend(
  byte canal,
  uint8_t direccion,
  uint8_t valor,
  uint8_t modo
) {

  uint8_t alto =
    valor & 0xF0;

  uint8_t bajo =
    (valor << 4) & 0xF0;

  lcdWrite4Bits(
    canal,
    direccion,
    alto | modo
  );

  lcdWrite4Bits(
    canal,
    direccion,
    bajo | modo
  );
}

void lcdCommand(
  byte canal,
  uint8_t direccion,
  uint8_t comando
) {

  lcdSend(
    canal,
    direccion,
    comando,
    0
  );
}

void lcdWrite(
  byte canal,
  uint8_t direccion,
  char caracter
) {

  lcdSend(
    canal,
    direccion,
    caracter,
    LCD_RS
  );
}

void lcdBegin(
  byte canal,
  uint8_t direccion
) {

  delay(50);

  lcdExpanderWrite(
    canal,
    direccion,
    0
  );

  delay(100);

  lcdWrite4Bits(
    canal,
    direccion,
    0x30
  );

  delayMicroseconds(4500);

  lcdWrite4Bits(
    canal,
    direccion,
    0x30
  );

  delayMicroseconds(4500);

  lcdWrite4Bits(
    canal,
    direccion,
    0x30
  );

  delayMicroseconds(150);

  lcdWrite4Bits(
    canal,
    direccion,
    0x20
  );

  lcdCommand(
    canal,
    direccion,
    0x28
  );

  lcdCommand(
    canal,
    direccion,
    0x08
  );

  lcdCommand(
    canal,
    direccion,
    0x01
  );

  delay(2);

  lcdCommand(
    canal,
    direccion,
    0x06
  );

  lcdCommand(
    canal,
    direccion,
    0x0C
  );
}

void lcdSetCursor(
  byte canal,
  uint8_t direccion,
  byte columna,
  byte fila
) {

  const uint8_t offsets[4] = {
    0x00,
    0x40,
    0x10,
    0x50
  };

  lcdCommand(
    canal,
    direccion,
    0x80 | (columna + offsets[fila])
  );
}

void lcdPrint(
  byte canal,
  uint8_t direccion,
  String texto
) {

  for (
    unsigned int i = 0;
    i < texto.length();
    i++
  ) {

    lcdWrite(
      canal,
      direccion,
      texto[i]
    );
  }
}

void escribirFila(
  byte canal,
  uint8_t direccion,
  byte fila,
  String texto
) {

  if (direccion == 0)
    return;

  if (texto.length() > 16)
    texto = texto.substring(0, 16);

  while (texto.length() < 16)
    texto += " ";

  lcdSetCursor(
    canal,
    direccion,
    0,
    fila
  );

  lcdPrint(
    canal,
    direccion,
    texto
  );
}

String lineaDerecha(
  String titulo,
  String valor
) {

  String linea = titulo;

  while (
    linea.length() +
    valor.length() <
    16
  ) {

    linea += " ";
  }

  linea += valor;

  if (linea.length() > 16)
    linea = linea.substring(0, 16);

  return linea;
}


