    MiniR4.OLED.clearDisplay();
    MiniR4.OLED.setTextSize(1);

    MiniR4.OLED.setCursor(25, 0);
    MiniR4.OLED.print("ATOM ARCHBOT");

    MiniR4.OLED.setCursor(32, 10);
    MiniR4.OLED.print("INICIANDO");

    MiniR4.OLED.setCursor(26, 22);
    MiniR4.OLED.print("[");

    for (byte i = 0; i < 10; i++) {

      if (i < paso)
        MiniR4.OLED.print("#");

      else
