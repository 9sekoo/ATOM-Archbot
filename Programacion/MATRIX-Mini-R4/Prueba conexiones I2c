// FILTRO

void guardarMuestra(int distancia) {

  muestras[indiceMuestra] =
    distancia;

  indiceMuestra++;

  if (
    indiceMuestra >=
    NUM_MUESTRAS
  ) {

    indiceMuestra = 0;
  }

  if (
    muestrasGuardadas <
    NUM_MUESTRAS
  ) {

    muestrasGuardadas++;
  }
}

int calcularMediana() {

  if (muestrasGuardadas == 0)
    return 0;

  int copia[NUM_MUESTRAS];

  for (
    byte i = 0;
    i < muestrasGuardadas;
    i++
  ) {

    copia[i] =
      muestras[i];
  }

  for (
    byte i = 0;
    i < muestrasGuardadas - 1;
    i++
  ) {

    for (
      byte j = i + 1;
      j < muestrasGuardadas;
      j++
    ) {

      if (
        copia[j] <
        copia[i]
      ) {

        int temporal =
          copia[i];

        copia[i] =
          copia[j];

        copia[j] =
          temporal;
      }
    }
  }

  return
    copia[muestrasGuardadas / 2];
}

void reiniciarFiltro() {

  indiceMuestra = 0;
  muestrasGuardadas = 0;

  distanciaFiltrada = 0;
}


// NIVELES

void actualizarNivel(int distancia) {

  if (
    distancia <=
    DISTANCIA_CRITICA
  ) {

    nivelActual =
      CRITICO;
  }

  else if (
    distancia <=
    LIMITE_ROJO
  ) {

    nivelActual =
      CERCA;
  }

  else if (
    distancia <
    INICIO_VERDE
  ) {

    nivelActual =
      MEDIO;
  }

  else {

    nivelActual =
      LEJOS;
  }
}

String textoNivel() {

  switch (nivelActual) {

    case CRITICO:
      return "CRITICO";

    case CERCA:
      return "CERCA";

    case MEDIO:
      return "MEDIO";

    case LEJOS:
      return "LEJOS";

    default:
      return "SIN DATO";
  }
}


// ALERTA

const uint16_t puntosDistancia[] = {
  36,
  50,
  75,
  100,
  150,
  200,
  300,
  500,
  800,
  1200,
  1999
};

const uint16_t puntosPeriodo[] = {
  90,
  110,
  150,
  200,
  320,
  450,
  650,
  950,
  1300,
  1650,
  2200
};

const byte NUM_PUNTOS_ALERTA =
  sizeof(puntosDistancia) /
  sizeof(puntosDistancia[0]);

unsigned long calcularPeriodoPitido(
  int distancia
) {

  if (
    distancia <=
    puntosDistancia[0]
  ) {

    return
      puntosPeriodo[0];
  }

  if (
    distancia >=
    puntosDistancia[NUM_PUNTOS_ALERTA - 1]
  ) {

    return
      puntosPeriodo[NUM_PUNTOS_ALERTA - 1];
  }

  for (
    byte i = 0;
    i < NUM_PUNTOS_ALERTA - 1;
    i++
  ) {

    if (
      distancia >= puntosDistancia[i] &&
      distancia <= puntosDistancia[i + 1]
    ) {

      long distanciaDentro =
        distancia -
        puntosDistancia[i];

      long tramoDistancia =
        puntosDistancia[i + 1] -
        puntosDistancia[i];

      long tramoPeriodo =
        puntosPeriodo[i + 1] -
        puntosPeriodo[i];

      return
        puntosPeriodo[i] +
        (
          tramoPeriodo *
          distanciaDentro /
          tramoDistancia
        );
    }
  }

  return 2200;
}

void activarPulsoLED() {

  pulsoLEDActivo =
    true;

  inicioPulsoLED =
    millis();
}

void actualizarBuzzer() {

  if (!laser1Lectura) {

    if (tonoCriticoActivo) {

      MiniR4.Buzzer.NoTone();

      tonoCriticoActivo =
        false;
    }

    periodoPitidoActual =
      0;

    return;
  }

  unsigned long ahora =
    millis();

  if (
    distanciaFiltrada <=
    DISTANCIA_CRITICA
  ) {

    periodoPitidoActual =
      0;

    if (
      !tonoCriticoActivo ||
      ahora -
      ultimaRenovacionCritica >=
      70
    ) {

      MiniR4.Buzzer.Tone(
        2000,
        140
      );

      ultimaRenovacionCritica =
        ahora;

      tonoCriticoActivo =
        true;
    }

    return;
  }

  if (tonoCriticoActivo) {

    MiniR4.Buzzer.NoTone();

    tonoCriticoActivo =
      false;

    ultimoPitido =
      ahora;
  }

  periodoPitidoActual =
    calcularPeriodoPitido(
      distanciaFiltrada
    );

  if (
    ahora -
    ultimoPitido >=
    periodoPitidoActual
  ) {

    ultimoPitido =
      ahora;

    MiniR4.Buzzer.Tone(
      1850,
      55
    );

    activarPulsoLED();
  }
}


// RGB

void colorNivel(
  uint8_t &r,
  uint8_t &g,
  uint8_t &b
) {

  r = 0;
  g = 0;
  b = 0;

  if (
    nivelActual == CRITICO ||
    nivelActual == CERCA
  ) {

    r = 255;
    g = 0;
    b = 0;
  }

  else if (
    nivelActual == MEDIO
  ) {

    r = 255;
    g = 145;
    b = 0;
  }

  else if (
    nivelActual == LEJOS
  ) {

    r = 0;
    g = 255;
    b = 0;
  }
}

void apagarLEDs() {

  MiniR4.LED.setColor(
    1,
    0,
    0,
    0
  );

  MiniR4.LED.setColor(
    2,
    0,
    0,
    0
  );
}

void actualizarLEDs() {

  if (!laser1Lectura) {

    apagarLEDs();

    pulsoLEDActivo =
      false;

    return;
  }

  if (
    nivelActual ==
    CRITICO
  ) {

    MiniR4.LED.setBrightness(
      1,
      255
    );

    MiniR4.LED.setBrightness(
      2,
      255
    );

    MiniR4.LED.setColor(
      1,
      255,
      0,
      0
    );

    MiniR4.LED.setColor(
      2,
      255,
      0,
      0
    );

    return;
  }

  if (
    pulsoLEDActivo &&
    millis() -
    inicioPulsoLED >=
    DURACION_PULSO_LED
  ) {

    pulsoLEDActivo =
      false;
  }

  int distanciaBrillo =
    constrain(
      distanciaFiltrada,
      35,
      1200
    );

  int brillo =
    map(
      distanciaBrillo,
      35,
      1200,
      180,
      30
    );

  brillo =
    constrain(
      brillo,
      30,
      180
    );

  if (pulsoLEDActivo)
    brillo = 255;

  uint8_t r;
  uint8_t g;
  uint8_t b;

  colorNivel(
    r,
    g,
    b
  );

  MiniR4.LED.setBrightness(
    1,
    brillo
  );

  MiniR4.LED.setBrightness(
    2,
    brillo
  );

  MiniR4.LED.setColor(
    1,
    r,
    g,
    b
  );

  MiniR4.LED.setColor(
    2,
    r,
    g,
    b
  );
}


