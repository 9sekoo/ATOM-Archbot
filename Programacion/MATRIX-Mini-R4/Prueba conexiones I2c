// LASERS

void iniciarLaserPrincipal() {

  laser1Iniciado =
    MiniR4.I2C4.MXLaserV2.begin();

  if (!laser1Iniciado) {

    laser1Lectura =
      false;
  }
}

void iniciarLaserSecundario() {

  if (!USAR_LASER2) {

    laser2Iniciado =
      false;

    laser2Lectura =
      false;

    return;
  }

  laser2Iniciado =
    MiniR4.I2C1.MXLaserV2.begin();

  if (!laser2Iniciado) {

    laser2Lectura =
      false;
  }
}


// SETUP

void setup() {

  MiniR4.begin();

  Serial.begin(115200);

  MiniR4.Buzzer.NoTone();

  apagarLEDs();

  animacionInicio();

  addr16x2 =
    buscarLCD(
      CANAL_LCD_16X2
    );

  if (addr16x2 != 0) {

    lcdBegin(
      CANAL_LCD_16X2,
      addr16x2
    );

    escribirFila(
      CANAL_LCD_16X2,
      addr16x2,
      0,
      "ATOM ARCHBOT"
    );

    escribirFila(
      CANAL_LCD_16X2,
      addr16x2,
      1,
      "LCD 16x2: OK"
    );
  }

  addr16x4 =
    buscarLCD(
      CANAL_LCD_16X4
    );

  if (addr16x4 != 0) {

    lcdBegin(
      CANAL_LCD_16X4,
      addr16x4
    );

    escribirFila(
      CANAL_LCD_16X4,
      addr16x4,
      0,
      "   ATOM ARCHBOT"
    );

    escribirFila(
      CANAL_LCD_16X4,
      addr16x4,
      1,
      "LCD 16x2:    OK"
    );

    escribirFila(
      CANAL_LCD_16X4,
      addr16x4,
      2,
      "LCD 16x4:    OK"
    );

    escribirFila(
      CANAL_LCD_16X4,
      addr16x4,
      3,
      "LASER:      ..."
    );
  }

  iniciarLaserPrincipal();
  iniciarLaserSecundario();

  delay(600);

  actualizarLCDs();
  actualizarOLED();
}


// LOOP

void loop() {

  unsigned long ahora =
    millis();

  if (
    !laser1Iniciado &&
    ahora -
    ultimoReintentoLaser >=
    REINTENTO_LASER
  ) {

    ultimoReintentoLaser =
      ahora;

    iniciarLaserPrincipal();
  }

  if (
    ahora -
    ultimoSensor >=
    INTERVALO_SENSOR
  ) {

    ultimoSensor =
      ahora;

    if (laser1Iniciado) {

      int lectura =
        MiniR4.I2C4.MXLaserV2.getDistance();

      if (
        lectura >= DIST_MIN_VALIDA &&
        lectura <= DIST_MAX_VALIDA
      ) {

        fallosLaser1 =
          0;

        laser1Lectura =
          true;

        guardarMuestra(
          lectura
        );

        distanciaFiltrada =
          calcularMediana();

        distanciaLaser1 =
          distanciaFiltrada;

        actualizarNivel(
          distanciaFiltrada
        );

        Serial.print(
          "L1: "
        );

        Serial.print(
          distanciaFiltrada
        );

        Serial.print(
          " mm | "
        );

        Serial.println(
          textoNivel()
        );
      }

      else {

        fallosLaser1++;

        if (
          fallosLaser1 >=
          MAX_FALLOS
        ) {

          laser1Lectura =
            false;

          nivelActual =
            SIN_DATO;

          reiniciarFiltro();

          MiniR4.Buzzer.NoTone();

          tonoCriticoActivo =
            false;
        }
      }
    }

    if (
      USAR_LASER2 &&
      laser2Iniciado
    ) {

      int lectura2 =
        MiniR4.I2C1.MXLaserV2.getDistance();

      if (
        lectura2 >= DIST_MIN_VALIDA &&
        lectura2 <= DIST_MAX_VALIDA
      ) {

        laser2Lectura =
          true;

        distanciaLaser2 =
          lectura2;
      }

      else {

        laser2Lectura =
          false;
      }
    }
  }

  actualizarBuzzer();

  if (
    ahora -
    ultimoLED >=
    INTERVALO_LED
  ) {

    ultimoLED =
      ahora;

    actualizarLEDs();
  }

  if (
    ahora -
    ultimaLCD >=
    INTERVALO_LCD
  ) {

    ultimaLCD =
      ahora;

    actualizarLCDs();
  }

  if (
    ahora -
    ultimoOLED >=
    INTERVALO_OLED
  ) {

    ultimoOLED =
      ahora;

    actualizarOLED();
  }
}
